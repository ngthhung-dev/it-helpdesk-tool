<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ITHelpdeskTool</AssemblyName>
    <RootNamespace>ITHelpdeskTool</RootNamespace>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Bản build cho máy kiểm thử tự động (TestBuild=true): có chế độ selftest và bỏ qua đăng nhập. Bản phát hành KHÔNG có. -->
  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST_BUILD</DefineConstants>
  </PropertyGroup>

  <!-- Đăng nhập kiểm tra qua mạng (AuthMode=online); mặc định là tài khoản đặt trên máy -->
  <PropertyGroup Condition="'$(AuthMode)' == 'online'">
    <DefineConstants>$(DefineConstants);AUTH_ONLINE</DefineConstants>
  </PropertyGroup>

  <!-- Thông tin hiển thị trong Properties > Details của file .exe -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>IT Helpdesk Tool by ngthhung</AssemblyTitle>
    <Product>IT Helpdesk Tool</Product>
    <Company>ngthhung</Company>
    <Authors>ngthhung</Authors>
    <Copyright>Copyright © 2026 ngthhung</Copyright>
    <Description>IT Helpdesk Tool by ngthhung</Description>
  </PropertyGroup>

  <!-- Publish: thư mục tự chứa runtime (không cần cài .NET).
       Không dùng single-file nén vì mỗi lần mở phải giải nén ~150 MB vào RAM → mở chậm, tốn RAM.
       ReadyToRun: biên dịch sẵn mã máy, giảm thời gian JIT lúc khởi động. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thông tin liên hệ, đọc lại qua AppInfo -->
    <AssemblyMetadata Include="ContactEmail" Value="ngthhung.dev@gmail.com" />
    <AssemblyMetadata Include="ContactPhone" Value="0968 799 365" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
