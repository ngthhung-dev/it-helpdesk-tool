<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ITHelpdeskTool</AssemblyName>
    <RootNamespace>ITHelpdeskTool</RootNamespace>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <!-- Thông tin hiển thị trong Properties > Details của file .exe -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>IT Helpdesk Tool by ngthhung</AssemblyTitle>
    <Product>IT Helpdesk Tool</Product>
    <Company>ngthhung</Company>
    <Authors>ngthhung</Authors>
    <Copyright>Copyright © 2026 ngthhung</Copyright>
    <Description>IT Helpdesk Tool by ngthhung</Description>
  </PropertyGroup>

  <!-- Publish: 1 file .exe tự chứa runtime, nén lại cho nhẹ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thông tin liên hệ, đọc lại qua AppInfo -->
    <AssemblyMetadata Include="ContactEmail" Value="ngthhung.dev@gmail.com" />
    <AssemblyMetadata Include="ContactPhone" Value="0968 799 365" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
