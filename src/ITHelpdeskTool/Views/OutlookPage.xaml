<UserControl x:Class="ITHelpdeskTool.Views.OutlookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OutlookViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1000">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Đầu trang ghim cố định (không cuộn) -->
            <StackPanel Margin="28,4,22,4">
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Dữ liệu Outlook" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                                   Text="Tìm và sao lưu file PST / OST, sửa file hỏng, dựng lại OST, sao lưu chữ ký, mở Outlook ở chế độ sửa lỗi."/>
                        <TextBlock Text="{Binding OutlookText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
            </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                    <!-- File dữ liệu -->
                    <Border c:SectionIndex.Title="File dữ liệu" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Tìm trong thư mục khác…" Command="{Binding AddFolderCommand}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="File dữ liệu" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource BtnSmall}" Content="Dựng lại" Margin="0,0,6,0" CommandParameter="{Binding}" Visibility="{Binding F.IsOst, Converter={StaticResource BoolVis}}"
                                                            ToolTip="Đổi tên file OST cũ để Outlook tải lại từ máy chủ"
                                                            Command="{Binding DataContext.RebuildOstCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Style="{StaticResource BtnSmall}" Content="Mở thư mục" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding F.Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding F.Detail}" Style="{StaticResource Hint}"/>
                                                    <TextBlock Text="{Binding F.Folder}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="Gần giới hạn 50 GB — nên lưu trữ bớt thư cũ (File › Tools › Clean Up / Archive)." FontSize="12" Foreground="{StaticResource WarnBrush}"
                                                               TextWrapping="Wrap" Visibility="{Binding F.NearLimit, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Sửa file PST / OST (ScanPST)" Command="{Binding ScanPstCommand}" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding BackupCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13"/>
                                            <TextBlock Text="Sao lưu file đã chọn…" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="PST là nơi duy nhất chứa thư của tài khoản POP / thư lưu trữ — cần sao lưu. OST chỉ là bản sao từ máy chủ, mất có thể tải lại."/>
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>


                    <!-- Sửa lỗi -->
                    <Border c:SectionIndex.Title="Sửa lỗi Outlook" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Run Text="Hồ sơ mặc định:"/> <Run Text="{Binding DefaultProfile, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                    </TextBlock>
                                    <Button Style="{StaticResource BtnSmall}" Content="Mail Setup (hồ sơ &amp; file dữ liệu)" Command="{Binding MailSetupCommand}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Mở Outlook để sửa lỗi" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Đóng Outlook trước khi bấm “Mở”." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,0,-16,0">
                                    <Border Style="{StaticResource Row}" Margin="0,0,16,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Mở" CommandParameter="/safe" VerticalAlignment="Center"
                                                Command="{Binding StartWithCommand}" IsEnabled="{Binding HasOutlook}"/>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Chế độ an toàn" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Tắt add-in — dùng khi Outlook treo / văng lúc mở." Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}" Margin="0,0,16,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Mở" CommandParameter="/resetnavpane" VerticalAlignment="Center"
                                                Command="{Binding StartWithCommand}" IsEnabled="{Binding HasOutlook}"/>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Đặt lại khung thư mục" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Sửa lỗi không mở được do khung bên trái hỏng." Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}" Margin="0,0,16,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Mở" CommandParameter="/cleanviews" VerticalAlignment="Center"
                                                Command="{Binding StartWithCommand}" IsEnabled="{Binding HasOutlook}"/>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Đặt lại kiểu hiển thị" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Khi danh sách thư hiển thị sai / mất cột." Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Row}" Margin="0,0,16,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Mở" CommandParameter="/cleanreminders" VerticalAlignment="Center"
                                                Command="{Binding StartWithCommand}" IsEnabled="{Binding HasOutlook}"/>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Xoá nhắc nhở lỗi" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="Khi nhắc lịch hiện liên tục / không tắt được." Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Chữ ký -->
                    <Border c:SectionIndex.Title="Chữ ký email" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Style="{StaticResource BtnSmall}" Content="Mở thư mục" Margin="0,0,6,0" Command="{Binding OpenSignaturesCommand}"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Khôi phục…" Margin="0,0,6,0" Command="{Binding RestoreSignaturesCommand}"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Sao lưu…" Command="{Binding BackupSignaturesCommand}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Chữ ký email" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Sao lưu / chuyển chữ ký sang máy mới (thư mục %APPDATA%\Microsoft\Signatures)."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Nhật ký thao tác -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding ActionLog.Count, Converter={x:Static core:Converters.CountVis}}">
                        <StackPanel>
                            <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource FaintBrush}"/>
                                        <Run Text="{Binding Text, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{StaticResource BadBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
