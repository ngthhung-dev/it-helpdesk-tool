<UserControl x:Class="ITHelpdeskTool.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="RowKey" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowVal" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
        <StackPanel MaxWidth="620" HorizontalAlignment="Center" Margin="0,24,0,0">

            <!-- Logo + tên -->
            <Image Source="/Assets/app.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding AppName}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="13">
                <Run Text="Phiên bản"/> <Run Text="{Binding Version, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                <Run Text="·"/> <Run Text="{Binding Runtime, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="Bộ công cụ hỗ trợ IT cho Windows: kiểm tra máy, tối ưu, cài đặt phần mềm, sửa lỗi hệ thống."
                       Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="13"/>

            <!-- Thông tin liên hệ -->
            <Border Style="{StaticResource Card}" Margin="0,26,0,0" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="Tác giả &amp; liên hệ" Style="{StaticResource H2}" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Width="30"/>
                        <TextBlock Text="Tác giả" Style="{StaticResource RowKey}"/>
                        <TextBlock Text="{Binding Author}" Style="{StaticResource RowVal}"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Width="30"/>
                        <TextBlock Text="Email" Style="{StaticResource RowKey}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource SmallBtn}" Content="Chép" Command="{Binding CopyEmailCommand}"/>
                            <Button Style="{StaticResource SmallBtn}" Content="Gửi email" Command="{Binding SendEmailCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Email}" Style="{StaticResource RowVal}"/>
                    </DockPanel>

                    <DockPanel>
                        <TextBlock Text="&#xE717;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Width="30"/>
                        <TextBlock Text="Điện thoại / Zalo" Style="{StaticResource RowKey}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallBtn}" Content="Chép" Command="{Binding CopyPhoneCommand}"/>
                        <TextBlock Text="{Binding Phone}" Style="{StaticResource RowVal}"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button HorizontalAlignment="Center" Margin="0,16,0,0" Command="{Binding OpenLogsCommand}"
                    ToolTip="Khi app lỗi hoặc chậm, gửi file app.log trong thư mục này cho tác giả">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13"/>
                    <TextBlock Text="Mở thư mục log" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{Binding Status}" Foreground="{StaticResource GoodBrush}" HorizontalAlignment="Center"
                       Margin="0,12,0,0" Height="18"/>
            <TextBlock Text="{Binding Copyright}" Style="{StaticResource Caption}" FontWeight="Normal"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
