<UserControl x:Class="ITHelpdeskTool.Views.MultiZaloPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MultiZaloViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Act" TargetType="Button" BasedOn="{StaticResource BtnSmall}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
        </Style>
        <Style x:Key="RunBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="#1A34D399"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Đầu trang ghim cố định (không cuộn) -->
        <StackPanel Margin="28,4,22,4">
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnSmall}" Content="Đóng tất cả Zalo" Margin="0,0,6,0" Command="{Binding CloseAllCommand}"/>
                    <Button Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding RefreshCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Multi-Zalo" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Text="Đăng nhập nhiều tài khoản Zalo cùng lúc trên một máy — mỗi tài khoản một hồ sơ riêng, có lối tắt riêng ngoài Desktop."/>
                    <TextBlock Text="{Binding ZaloText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
        </StackPanel>

    <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
        <StackPanel>
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource WarnBrush}" Margin="0,0,0,12" Visibility="{Binding Installed, Converter={StaticResource NotBoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Cài Zalo PC" Command="{Binding InstallZaloCommand}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Chưa cài Zalo PC" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Cài Zalo từ trang App Store (tải từ trang Zalo), rồi quay lại đây tạo hồ sơ."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <WrapPanel c:SectionIndex.Title="Tài khoản Zalo">
                <!-- Zalo chính -->
                <Border Style="{StaticResource Card}" Width="340" Margin="0,0,12,12" Padding="16,14">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource RunBadge}" Visibility="{Binding MainRunning, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Đang mở" FontSize="11.5" Foreground="{DynamicResource GoodBrush}"/>
                            </Border>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#2A5B8CFF" Margin="0,0,12,0">
                                <TextBlock Text="Z" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Zalo chính" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Hint}"><Run Text="Hồ sơ mặc định ·"/> <Run Text="{Binding MainSize, Mode=OneWay}"/></TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource BtnSmall}" Content="Mở" Margin="0,0,6,6" Command="{Binding StartMainCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="340" Margin="0,0,12,12" Padding="16,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource RunBadge}" Visibility="{Binding Running, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Đang mở" FontSize="11.5" Foreground="{DynamicResource GoodBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Avatar}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding P.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding P.Folder}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource BtnPrimary}" Content="Mở" Margin="0,0,6,6" Padding="14,4" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Style="{StaticResource Act}" Content="Lối tắt Desktop" Command="{Binding DataContext.ShortcutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Style="{StaticResource Act}" Content="Đổi tên" Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Style="{StaticResource Act}" Content="Thư mục" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Style="{StaticResource Act}" Content="Xoá" Foreground="{DynamicResource BadBrush}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <!-- Tạo hồ sơ -->
            <Border c:SectionIndex.Title="Thêm tài khoản" Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Thêm tài khoản Zalo" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                               Text="Tạo hồ sơ mới → Zalo mở ra màn hình đăng nhập riêng (quét mã QR bằng tài khoản thứ hai). Lần sau mở bằng lối tắt “Zalo - tên” ngoài Desktop."/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding CreateCommand}" IsEnabled="{Binding Installed}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="Tạo và mở" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Tag="Tên hồ sơ, vd Zalo bán hàng"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đổi…" Margin="8,0,0,0" Command="{Binding PickBaseCommand}"/>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center">
                            <Run Text="Lưu dữ liệu tại:"/> <Run Text="{Binding BaseDir, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource MonoFont}"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Hạn chế khi mở nhiều Zalo -->
            <Border c:SectionIndex.Title="Lưu ý" Style="{StaticResource Card}" BorderBrush="{DynamicResource WarnBrush}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Lưu ý: chụp màn hình khi mở nhiều Zalo" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                               Text="Phím tắt chụp màn hình của Zalo (Ctrl+Alt+S, Ctrl+Alt+A) không dùng được khi mở từ 2 Zalo trở lên, kể cả khi đổi phím tắt khác nhau. Nguyên nhân: Zalo chụp màn hình bằng chương trình phụ ZaloCap.exe, mà chương trình này chỉ cho chạy một bản trên cả máy — Zalo mở sau tắt bộ chụp của Zalo mở trước nên các Zalo giành nhau. Đây là giới hạn của Zalo, không sửa được từ bên ngoài."/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"
                               Text="Cách thay thế (dùng được cho mọi Zalo): bấm Win+Shift+S hoặc PrtScn để chụp bằng công cụ của Windows, rồi bấm Ctrl+V vào ô chat Zalo để gửi ảnh."/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnSmall}" Content="Chụp thử ngay" Margin="0,0,6,6" Command="{Binding OpenSnipCommand}"/>
                        <Button Style="{StaticResource BtnSmall}" Content="Bật chụp bằng phím PrtScn" Margin="0,0,6,6" Command="{Binding EnablePrtScnCommand}"
                                Visibility="{Binding PrtScnOn, Converter={StaticResource NotBoolVis}}"/>
                        <TextBlock Text="✓ Phím PrtScn đang mở công cụ chụp màn hình" Foreground="{DynamicResource GoodBrush}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,6"
                                   Visibility="{Binding PrtScnOn, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding ActionLog}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/>
                            <Run Text="{Binding Text, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
