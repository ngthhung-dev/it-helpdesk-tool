<Window x:Class="ITHelpdeskTool.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,12,0"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="16" TextWrapping="Wrap" MaxWidth="350"/>
            </StackPanel>
            <!-- Nội dung dài: cuộn trong khung, cửa sổ không bao giờ cao quá màn hình -->
            <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                <TextBlock x:Name="MessageText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/>
            </ScrollViewer>

            <TextBox x:Name="OutputText" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1" Padding="10,8" Margin="0,4,0,0"/>

            <TextBox x:Name="InputText" Style="{StaticResource InputBox}" Margin="0,16,0,0" Visibility="Collapsed"/>

            <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="Pw1"/>
                <TextBlock Text="Nhập lại mật khẩu" Style="{StaticResource Muted}" Margin="0,12,0,6"/>
                <PasswordBox x:Name="Pw2"/>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CopyButton" Content="Chép" MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed" Click="Copy_Click"/>
                <Button x:Name="CancelButton" Content="Huỷ" MinWidth="88" IsCancel="True" Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="Đồng ý" MinWidth="88" Margin="8,0,0,0" IsDefault="True"
                        Style="{StaticResource BtnPrimary}" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
