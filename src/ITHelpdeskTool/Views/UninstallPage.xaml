<UserControl x:Class="ITHelpdeskTool.Views.UninstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:UninstallViewModel}"
             d:DesignWidth="1100" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <core:NullToVisibility x:Key="NullVis"/>
        <core:NullToVisibility x:Key="NotNullVis" Invert="True"/>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Cmd" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <Style x:Key="TabSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="uninstTab"/>
        </Style>
        <Style x:Key="EmptyHidden" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28,4,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Đầu trang ===== -->
            <DockPanel Margin="0,0,0,14">
                <TextBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center" Style="{StaticResource SearchBox}" MinHeight="32"
                         Tag="Tìm phần mềm…" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                <StackPanel>
                    <TextBlock Text="Gỡ app sạch" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Text="Chạy trình gỡ của hãng, sau đó tìm và dọn file, registry, dịch vụ, tác vụ còn sót lại."/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,12" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabApps}" Content="Phần mềm đã cài"/>
                    <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabStore}" Content="Ứng dụng Store &amp; cài sẵn"/>
                </StackPanel>
            </Border>

            <!-- ===================== TAB PHẦN MỀM ===================== -->
            <Grid Grid.Row="2" Visibility="{Binding TabApps, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Danh sách -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding LoadCommand}"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Apps}" Background="Transparent" BorderThickness="0" Padding="8,0,8,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Background="Transparent" MouseLeftButtonUp="App_Click">
                                        <Grid Width="28" Height="28" Margin="0,0,12,0">
                                            <Image Source="{Binding App.Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                                       Visibility="{Binding App.Icon, Converter={StaticResource NotNullVis}}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding App.Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding App.Detail}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Bảng gỡ -->
                <Border Grid.Column="1" Width="460" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,14,16">
                        <StackPanel IsEnabled="{Binding IsIdle}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Content="&#xE711;" Width="32" Height="28"
                                        Command="{Binding CloseSelectionCommand}" ToolTip="Đóng"/>
                                <Image Source="{Binding Selected.Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Selected.Name}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Thư mục cài đặt" Style="{StaticResource Caption}" Margin="0,14,0,2"/>
                            <TextBlock Text="{Binding Selected.InstallLocation, TargetNullValue='—'}" Style="{StaticResource Cmd}"/>
                            <TextBlock Text="Lệnh gỡ" Style="{StaticResource Caption}" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding Selected.UninstallString}" Style="{StaticResource Cmd}"/>

                            <CheckBox IsChecked="{Binding Quiet}" Margin="0,14,0,0"
                                      Content="Gỡ im lặng nếu được (MSI, Inno Setup, NSIS)"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,8" Command="{Binding UninstallCommand}"
                                        IsEnabled="{Binding Selected.HasUninstaller}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Gỡ cài đặt" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Quét phần còn sót" Margin="0,0,8,8" Command="{Binding ScanCommand}"
                                        ToolTip="Dùng khi đã tự gỡ trước đó, hoặc phần mềm không còn trình gỡ"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding StageText}" Style="{StaticResource EmptyHidden}" Foreground="{DynamicResource WarnBrush}" Margin="0,4,0,0"/>

                            <!-- Phần còn sót -->
                            <StackPanel Visibility="{Binding Leftovers.Count, Converter={x:Static core:Converters.CountVis}}" Margin="0,10,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkButton}" Content="Tất cả" Margin="0,0,10,0" Command="{Binding SelectLeftoversCommand}" CommandParameter="all"/>
                                        <Button Style="{StaticResource LinkButton}" Content="Đề xuất" Margin="0,0,10,0" Command="{Binding SelectLeftoversCommand}" CommandParameter="default"/>
                                        <Button Style="{StaticResource LinkButton}" Content="Bỏ chọn" Command="{Binding SelectLeftoversCommand}" CommandParameter="none"/>
                                    </StackPanel>
                                    <TextBlock Text="Phần còn sót" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding LeftoverSummary}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Leftovers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Mở" VerticalAlignment="Top" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding Item.KindText}" Style="{StaticResource BadgeText}"/></Border>
                                                            <Border Style="{StaticResource Badge}" Background="#1AFBBF24" Visibility="{Binding Item.HighConfidence, Converter={StaticResource NotBoolVis}}">
                                                                <TextBlock Text="Xem kỹ" Style="{StaticResource BadgeText}" Foreground="{DynamicResource WarnBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Item.Path}" Style="{StaticResource Cmd}" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Item.Detail}" Style="{StaticResource Hint}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Xoá mục đã chọn" Command="{Binding RemoveLeftoversCommand}"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Thư mục sao lưu registry" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Command="{Binding OpenBackupsCommand}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===================== TAB STORE ===================== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding TabStore, Converter={StaticResource BoolVis}}"
                    IsEnabled="{Binding IsIdle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnSmall}" Content="Chọn ứng dụng rác cài sẵn" Margin="6,0,0,0" Command="{Binding SelectBloatCommand}"/>
                            <Button Style="{StaticResource BtnSmall}" Content="Đọc lại" Margin="6,0,0,0" Command="{Binding LoadStoreCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StoreSummary}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="18,10,18,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Gỡ ứng dụng đã chọn" Command="{Binding RemoveStoreCommand}"/>
                        <CheckBox IsChecked="{Binding StoreAllUsers}" VerticalAlignment="Center"
                                  Content="Gỡ cho mọi tài khoản và không cho Windows cài lại cho tài khoản mới"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
                        <ItemsControl ItemsSource="{Binding StoreApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding App.Display}" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0"/>
                                                    <Border Style="{StaticResource Badge}" Background="#1AFBBF24" Visibility="{Binding App.IsBloat, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="Cài sẵn, thường không cần" Style="{StaticResource BadgeText}" Foreground="{DynamicResource WarnBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource Hint}">
                                                    <Run Text="{Binding App.Name, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding App.Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding App.Publisher, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
