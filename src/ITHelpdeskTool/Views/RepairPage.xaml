<UserControl x:Class="ITHelpdeskTool.Views.RepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RepairViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1000">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="EmptyHidden" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,4,22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Đầu trang ghim cố định -->
        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="Sửa lỗi Windows" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                       Text="Công cụ sửa lỗi có sẵn của Microsoft: SFC, DISM, CHKDSK, đặt lại Windows Update, mạng, máy in… Chạy từng mục hoặc sửa tự động."/>
            <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
        </StackPanel>

        <!-- ===== Trái: công cụ ===== -->
        <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Sửa tự động -->
                <Border c:SectionIndex.Title="Sửa tự động" Style="{StaticResource Card}" Margin="0,0,0,12" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel>
                        <TextBlock Text="Sửa file hệ thống tự động" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Tạo điểm khôi phục → DISM RestoreHealth → SFC. Dùng khi Windows chạy chập chờn, lỗi ứng dụng hệ thống, cập nhật hỏng."/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                            <Run Text="Nguồn sửa DISM:"/> <Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
                        </TextBlock>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource BtnPrimary}" Command="{Binding AutoRepairCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="13"/>
                                    <TextBlock Text="Sửa tự động" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LinkButton}" Content="Dùng bộ cài ISO làm nguồn…" Margin="0,0,12,6" VerticalAlignment="Center" Command="{Binding PickSourceCommand}"
                                    ToolTip="Khi máy không có mạng hoặc DISM báo không tìm thấy file nguồn"/>
                            <Button Style="{StaticResource LinkButton}" Content="Bỏ ISO, dùng lại Windows Update" Margin="0,0,0,6" VerticalAlignment="Center" Command="{Binding ClearSourceCommand}"
                                    Visibility="{Binding HasCustomSource, Converter={StaticResource BoolVis}}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border c:SectionIndex.Title="{Binding Name}" Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Tools}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Chạy" VerticalAlignment="Center" Margin="12,0,0,0"
                                                                IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Tool.Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Tool.Title}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="Cần khởi động lại" FontSize="11.5" Foreground="{DynamicResource WarnBrush}"
                                                                       Visibility="{Binding Tool.NeedsRestart, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding Tool.Description}" Style="{StaticResource Hint}"/>
                                                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock x:Name="Res" Text="{Binding Result}" Style="{StaticResource EmptyHidden}" Margin="0,4,0,0" Foreground="{DynamicResource GoodBrush}"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                                        <Setter TargetName="Res" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Phải: tình trạng + nhật ký ===== -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding LoadStatusCommand}"/>
                        <TextBlock Text="Tình trạng máy" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding OsText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RebootText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RebootPending}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ShutdownText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding CrashText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding Crashes}" Margin="8,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource FaintBrush}" FontFamily="{StaticResource MonoFont}">
                                    <Run Text="{Binding Time, Mode=OneWay, StringFormat=dd/MM/yyyy HH:mm}"/> <Run Text="{Binding File, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource Chip}" Content="Khôi phục hệ thống" Command="{Binding OpenToolCommand}" CommandParameter="rstrui"/>
                        <Button Style="{StaticResource Chip}" Content="Lịch sử ổn định" Command="{Binding OpenToolCommand}" CommandParameter="reliability"/>
                        <Button Style="{StaticResource Chip}" Content="Event Viewer" Command="{Binding OpenToolCommand}" CommandParameter="events"/>
                        <Button Style="{StaticResource Chip}" Content="Troubleshoot" Command="{Binding OpenToolCommand}" CommandParameter="troubleshoot"/>
                        <Button Style="{StaticResource Chip}" Content="Recovery" Command="{Binding OpenToolCommand}" CommandParameter="recovery"/>
                        <Button Style="{StaticResource Chip}" Content="Thư mục Minidump" Command="{Binding OpenToolCommand}" CommandParameter="minidump"/>
                        <Button Style="{StaticResource Chip}" Content="CBS.log" Command="{Binding OpenToolCommand}" CommandParameter="cbs"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnSmall}" Content="Dừng" Margin="0,0,6,0" Command="{Binding StopCommand}"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                            <Button Style="{StaticResource BtnSmall}" Content="Xoá" Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Nhật ký" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding Current}" Style="{StaticResource EmptyHidden}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar DockPanel.Dock="Top" Height="3" Margin="16,0,16,6" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="14,0,10,12"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
