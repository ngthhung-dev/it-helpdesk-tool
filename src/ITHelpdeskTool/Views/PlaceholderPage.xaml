<UserControl x:Class="ITHelpdeskTool.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
            <Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="30"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,6"/>
            <TextBlock Text="{Binding PhaseText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="13"/>
        </StackPanel>
    </Grid>
</UserControl>
