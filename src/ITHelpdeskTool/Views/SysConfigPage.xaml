<UserControl x:Class="ITHelpdeskTool.Views.SysConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SysConfigViewModel}"
             d:DesignWidth="1000" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <core:NullToVisibility x:Key="NullVis"/>

        <!-- Tiêu đề thẻ -->
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SegmentHost" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ToggleRow" TargetType="CheckBox" BasedOn="{StaticResource Toggle}">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Đầu trang ghim cố định (không cuộn) -->
            <StackPanel Margin="28,4,22,4">

                <!-- ===== Đầu trang ===== -->
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Đọc lại" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Cấu hình hệ thống" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13"
                                   Text="Tên máy, giờ, mạng, tài khoản, truy cập từ xa và các thiết lập Windows thường dùng."/>
                    </StackPanel>
                </DockPanel>

                <c:SectionIndex Target="{Binding ElementName=Scroller}" Margin="0,0,0,2"/>
            </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                <!-- Cần khởi động lại -->
                <Border CornerRadius="10" Background="#1AFBBF24" BorderBrush="#55FBBF24" BorderThickness="1" Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding NeedsRestart, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Khởi động lại ngay" Command="{Binding RestartCommand}"/>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0"/>
                        <TextBlock Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Có thay đổi cần khởi động lại máy mới có hiệu lực."/>
                    </DockPanel>
                </Border>


                <StackPanel IsEnabled="{Binding IsIdle}">

                    <!-- ===== Tên máy & nhóm ===== -->
                    <Border c:SectionIndex.Title="Tên máy &amp; nhóm" x:Name="CardIdentity" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tên máy &amp; nhóm làm việc" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}">
                                <Run Text="Tên máy:" Foreground="{StaticResource MutedBrush}"/>
                                <Run Text="{Binding Identity.ComputerName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="   ·   " Foreground="{StaticResource FaintBrush}"/>
                                <Run Text="{Binding GroupText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Margin="0,-8,0,14" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                       Text="{Binding Identity.PendingName, StringFormat='Sẽ đổi thành {0} sau khi khởi động lại.'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Identity.PendingName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tên máy mới" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Đổi tên" Margin="8,0,0,0" Command="{Binding RenameCommand}"/>
                                        <TextBox Style="{StaticResource InputBox}" MaxLength="15" Tag="vd: KETOAN-01"
                                                 Text="{Binding NewComputerName, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Tối đa 15 ký tự: chữ không dấu, số, dấu gạch ngang."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Workgroup" Style="{StaticResource Label}"/>
                                    <DockPanel IsEnabled="{Binding Identity.InDomain, Converter={x:Static core:Converters.Not}, FallbackValue=True}">
                                        <Button DockPanel.Dock="Right" Content="Đổi" Margin="8,0,0,0" Command="{Binding SetWorkgroupCommand}"/>
                                        <TextBox Style="{StaticResource InputBox}" MaxLength="15" Tag="WORKGROUP" CharacterCasing="Upper"
                                                 Text="{Binding NewWorkgroup, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Các máy cùng workgroup thấy nhau dễ hơn trong mạng LAN. Máy trong domain đổi ở System Properties."/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ===== Ngày giờ & khu vực ===== -->
                    <Border c:SectionIndex.Title="Ngày giờ &amp; khu vực" x:Name="CardTime" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Dịch vụ thời gian: đã dừng"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TimeServiceRunning}" Value="True">
                                                    <Setter Property="Text" Value="Dịch vụ thời gian: đang chạy"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Ngày giờ &amp; khu vực" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="{Binding CurrentTime}" Style="{StaticResource BigNumber}" FontSize="24" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Múi giờ" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Áp dụng" Margin="8,0,0,0" Command="{Binding ApplyTimeZoneCommand}"/>
                                        <ComboBox ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone}" MaxDropDownHeight="360">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Máy chủ thời gian (NTP)" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Đồng bộ ngay" Margin="8,0,0,0" Command="{Binding SyncTimeCommand}"/>
                                        <TextBox Style="{StaticResource InputBox}" Tag="time.windows.com" Text="{Binding NtpServer, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Định dạng ngày, giờ, số (cho tài khoản đang dùng)" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Áp dụng" Margin="8,0,0,0" Command="{Binding ApplyCultureCommand}"/>
                                <ComboBox ItemsSource="{Binding Cultures}" SelectedValuePath="Key" SelectedValue="{Binding SelectedCulture}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Value}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding CurrentCulture, StringFormat='Đang dùng: {0}'}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Mạng ===== -->
                    <Border c:SectionIndex.Title="Mạng" x:Name="CardNetwork" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE839;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Mạng" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Card mạng" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource FaintBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Connected}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                                <Run Text="{Binding SelectedAdapter.Mac, Mode=OneWay, StringFormat='MAC {0}'}"/>
                                <Run Text="{Binding SelectedAdapter.Ip, Mode=OneWay, StringFormat=' · IP hiện tại {0}'}"/>
                            </TextBlock>

                            <!-- Địa chỉ IP -->
                            <TextBlock Text="Địa chỉ IP" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ipmode" Content="Tự động (DHCP)" IsChecked="{Binding UseDhcp}"/>
                                    <RadioButton Style="{StaticResource Segment}" GroupName="ipmode" Content="IP tĩnh" IsChecked="{Binding UseStatic}"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding UseStatic}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="IP" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputBox}" Tag="192.168.1.50" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Subnet mask" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputBox}" Tag="255.255.255.0" Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Gateway" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputBox}" Tag="192.168.1.1" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- DNS -->
                            <TextBlock Text="DNS" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                            <DockPanel>
                                <Border Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="dnsmode" Content="Tự động" IsChecked="{Binding DnsAuto}"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="dnsmode" Content="Nhập tay" IsChecked="{Binding DnsManual}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Chọn nhanh:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Google" Margin="4,0,0,0" Command="{Binding DnsPresetCommand}" CommandParameter="google"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Cloudflare" Margin="4,0,0,0" Command="{Binding DnsPresetCommand}" CommandParameter="cloudflare"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Quad9" Margin="4,0,0,0" Command="{Binding DnsPresetCommand}" CommandParameter="quad9"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding DnsManual}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="DNS chính" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputBox}" Tag="8.8.8.8" Text="{Binding Dns1, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DNS phụ" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource InputBox}" Tag="8.8.4.4" Text="{Binding Dns2, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,18,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Áp dụng cấu hình mạng" Command="{Binding ApplyNetworkCommand}"/>
                                <WrapPanel>
                                    <Button Content="Xoá cache DNS" Margin="0,0,8,0" Command="{Binding FlushDnsCommand}"
                                            ToolTip="ipconfig /flushdns — dùng khi vừa đổi DNS hoặc web vào sai địa chỉ"/>
                                    <Button Content="Xin lại IP" Margin="0,0,8,0" Command="{Binding RenewIpCommand}"
                                            ToolTip="ipconfig /release + /renew"/>
                                    <Button Style="{StaticResource BtnDanger}" Content="Reset mạng" Command="{Binding ResetNetworkCommand}"
                                            ToolTip="netsh winsock reset + netsh int ip reset"/>
                                </WrapPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== Tài khoản ===== -->
                    <Border c:SectionIndex.Title="Tài khoản" x:Name="CardUsers" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Tài khoản người dùng" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding UsersError}" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsersError}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Users}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Mật khẩu" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.SetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Margin="6,0,0,0"
                                                            Command="{Binding DataContext.ToggleUserEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                                                                <Setter Property="Content" Value="Tắt"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="Content" Value="Bật"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Margin="6,0,0,0"
                                                            Command="{Binding DataContext.ToggleUserAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnSmall}">
                                                                <Setter Property="Content" Value="Cấp admin"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                                        <Setter Property="Content" Value="Bỏ admin"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Margin="6,0,0,0" Content="Xoá"
                                                            Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource BtnDanger}">
                                                                <Setter Property="Padding" Value="10,4"/>
                                                                <Setter Property="FontSize" Value="12"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBuiltinAdmin}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                                                        <Setter Property="Visibility" Value="Hidden"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>

                                                <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource Badge}" Background="#1A5B8CFF"
                                                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Quản trị" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="#1A34D399"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Đang dùng" FontSize="11" Foreground="{StaticResource GoodBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="#14FFFFFF"
                                                                Visibility="{Binding Enabled, Converter={StaticResource NotBoolVis}}">
                                                            <TextBlock Text="Đã tắt" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="#14FFFFFF"
                                                                Visibility="{Binding IsSystem, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Tài khoản hệ thống" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="#14FFFFFF"
                                                                Visibility="{Binding IsBuiltinAdmin, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="Administrator có sẵn" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{Binding Detail}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Tạo tài khoản mới" Style="{StaticResource Label}" Margin="0,16,0,6"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Tạo tài khoản" Margin="12,0,0,0"
                                        Command="{Binding CreateUserCommand}"/>
                                <CheckBox DockPanel.Dock="Right" Content="Quyền quản trị" Margin="12,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding NewUserAdmin}"/>
                                <TextBox Style="{StaticResource InputBox}" Tag="Tên đăng nhập, vd: nhanvien1" MaxLength="20"
                                         Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Bấm Tạo sẽ hỏi mật khẩu. Mật khẩu không bao giờ được ghi vào log."/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Truy cập & chia sẻ ===== -->
                    <Border c:SectionIndex.Title="Truy cập &amp; chia sẻ" x:Name="CardSharing" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE8AF;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Truy cập từ xa &amp; chia sẻ" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding NlaRequired, Mode=OneWay}"
                                      Command="{Binding SetNlaCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="Bắt buộc xác thực NLA" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="An toàn hơn. Tắt khi máy kết nối tới là Windows rất cũ hoặc gặp lỗi CredSSP."/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding FileSharing, Mode=OneWay}"
                                      Command="{Binding SetFileSharingCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="Chia sẻ file &amp; máy in (kèm cho phép ping)" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Mở tường lửa cho thư mục/máy in chia sẻ trong mạng LAN. Chỉ áp dụng cho mạng Private/Domain."/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding NetworkDiscovery, Mode=OneWay}"
                                      Command="{Binding SetNetworkDiscoveryCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="Network Discovery" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Cho máy này hiện trong mục Network của các máy khác và ngược lại."/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Style="{StaticResource ToggleRow}" Margin="0" IsChecked="{Binding RdpEnabled, Mode=OneWay}"
                                      Command="{Binding SetRdpCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="Remote Desktop" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Cho phép điều khiển máy này qua Remote Desktop (cổng 3389). Bản Windows Home không hỗ trợ."/>
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <!-- ===== Hệ thống ===== -->
                    <Border c:SectionIndex.Title="Hệ thống" x:Name="CardSystem" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE770;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Hệ thống" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Điểm khôi phục (System Restore)" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding RestoreText}" Margin="0,2,0,8"/>
                                    <DockPanel IsEnabled="{Binding RestoreSupported}">
                                        <Button DockPanel.Dock="Right" Content="Tạo điểm khôi phục" Margin="8,0,0,0" Command="{Binding CreateRestorePointCommand}"/>
                                        <TextBox Style="{StaticResource InputBox}" Tag="Mô tả" MaxLength="80"
                                                 Text="{Binding RestoreDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <CheckBox Style="{StaticResource ToggleRow}" BorderBrush="{StaticResource BorderBrush}" IsChecked="{Binding FastStartupOn, Mode=OneWay}"
                                      Command="{Binding SetFastStartupCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="Fast Startup (khởi động nhanh)" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Nên tắt khi máy hay lỗi driver, mất mạng sau khi bật máy, hoặc cài song song nhiều hệ điều hành."/>
                                </StackPanel>
                            </CheckBox>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,2,0,14">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Mở" Command="{Binding OpenHostsCommand}"/>
                                        <Button Content="Khôi phục mặc định" Margin="8,0,0,0" Command="{Binding ResetHostsCommand}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="File hosts" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{Binding HostsText}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <CheckBox Style="{StaticResource ToggleRow}" IsChecked="{Binding HibernateOn, Mode=OneWay}"
                                      Command="{Binding SetHibernateCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}">
                                <StackPanel>
                                    <TextBlock Text="Hibernate (ngủ đông)" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Tắt sẽ xoá file hiberfil.sys, lấy lại vài GB ổ C. Tắt Hibernate thì Fast Startup cũng tắt theo."/>
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0" Text="{Binding PagefileText, StringFormat='Bộ nhớ ảo (page file): {0}'}"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Mở nhanh ===== -->
                    <Border c:SectionIndex.Title="Mở nhanh" x:Name="CardTools" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mở nhanh cài đặt Windows" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding QuickTools}" Margin="-5,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource TileButton}" Margin="5"
                                                Command="{Binding DataContext.OpenQuickToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Nhật ký thao tác ===== -->
                <Border c:SectionIndex.Title="Nhật ký" x:Name="CardLog" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <TextBlock Text="Chưa có thao tác nào trong lần mở này.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActionLog.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ActionLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Hint}" Width="64" FontFamily="{StaticResource MonoFont}"/>
                                        <TextBlock Width="18" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                                            <Setter Property="Text" Value="&#xE711;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Thanh trạng thái khi đang làm -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Foreground="{StaticResource TextBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding BusyText}"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsBusy}" Value="False"/>
                                        <Condition Binding="{Binding IsLoading}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Text" Value="Đang đọc cấu hình…"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
