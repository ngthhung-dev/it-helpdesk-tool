<UserControl x:Class="ITHelpdeskTool.Views.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CleanupViewModel}"
             d:DesignWidth="1000" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:NullToVisibility x:Key="NullVis"/>

        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
        <Style x:Key="EmptyHidden" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Đầu trang ghim cố định (không cuộn) -->
            <StackPanel Margin="28,4,22,4">

                <!-- ===== Đầu trang ===== -->
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Width="280" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DriveText}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                        <ProgressBar Value="{Binding DriveUsedPercent}" Maximum="100" Height="8"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Dọn rác" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                                   Text="Chỉ xoá file tạm, bộ nhớ đệm và file hệ thống không còn cần — không đụng tới tài liệu, ảnh, mật khẩu trình duyệt."/>
                    </StackPanel>
                </DockPanel>

                <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
            </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                <!-- ===== Danh sách mục ===== -->
                <Border c:SectionIndex.Title="File rác" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnSmall}" Content="Chọn tất cả" Margin="6,0,0,0" Command="{Binding SelectAllCommand}" CommandParameter="all"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Mặc định" Margin="6,0,0,0" Command="{Binding SelectAllCommand}" CommandParameter="default"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Bỏ chọn" Margin="6,0,0,0" Command="{Binding SelectAllCommand}" CommandParameter="none"/>
                            </StackPanel>
                            <Border Style="{StaticResource CardIcon}">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="File rác" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="{Binding BrowserWarning}" Style="{StaticResource EmptyHidden}" Foreground="{DynamicResource WarnBrush}" Margin="0,0,0,6"/>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Width="210" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding ResultText}" HorizontalAlignment="Right" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                                                <DataTrigger Binding="{Binding ResultTone}" Value="Good"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Foreground="{DynamicResource WarnBrush}"
                                                           Visibility="{Binding Note, Converter={StaticResource NullVis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <DockPanel Margin="0,14,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Quét lại" Margin="0,0,8,0" Command="{Binding ScanCommand}"/>
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding CleanCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Dọn các mục đã chọn" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Dọn sâu ===== -->
                <Border c:SectionIndex.Title="Dọn sâu hệ thống" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource CardIcon}">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Dọn sâu hệ thống" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Xoá bản Windows cũ" VerticalAlignment="Center"
                                        IsEnabled="{Binding HasOldInstall}" Command="{Binding RemoveOldInstallCommand}"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Bản Windows cũ sau khi nâng cấp (Windows.old)" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Text="{Binding OldInstallText}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Dọn WinSxS" VerticalAlignment="Center" Command="{Binding ComponentCleanupCommand}"/>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Kho thành phần Windows (WinSxS)" Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                               Text="DISM /StartComponentCleanup — xoá bản cũ của file hệ thống sau khi cập nhật. Thường giải phóng 1–5 GB, mất 5–30 phút."/>
                                    <CheckBox IsChecked="{Binding ResetBase}" Content="Dọn mạnh (/ResetBase) — không gỡ được bản cập nhật đã cài"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Mở Disk Cleanup của Windows" Margin="0,0,8,0" Command="{Binding OpenDiskCleanupCommand}"/>
                            <Button Content="Storage Sense" Command="{Binding OpenStorageSettingsCommand}" ToolTip="Cho Windows tự dọn file tạm định kỳ"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Nhật ký ===== -->
                <Border c:SectionIndex.Title="Nhật ký" Style="{StaticResource Card}" Visibility="{Binding ActionLog.Count, Converter={x:Static core:Converters.CountVis}}">
                    <StackPanel>
                        <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ActionLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Hint}" Width="64" FontFamily="{StaticResource MonoFont}"/>
                                        <TextBlock Width="18" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                                            <Setter Property="Text" Value="&#xE711;"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
