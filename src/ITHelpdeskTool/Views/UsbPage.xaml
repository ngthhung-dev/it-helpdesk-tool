<UserControl x:Class="ITHelpdeskTool.Views.UsbPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:UsbViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SchemeSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="usbScheme"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,4,22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="460"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Đầu trang ghim cố định -->
        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="Tạo USB boot" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                       Text="Tạo USB cài Windows từ file ISO gốc của Microsoft. USB định dạng FAT32, khởi động được trên máy UEFI; install.wim lớn hơn 4 GB được tự chia nhỏ."/>
            <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel IsEnabled="{Binding IsIdle}">

                <!-- 1. Bộ cài -->
                <Border c:SectionIndex.Title="Bộ cài Windows" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Bộ cài Windows" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Chọn file ISO gốc của Microsoft (tải ở trang “Tải ISO”) hoặc thư mục đã giải nén bộ cài." Style="{StaticResource Hint}"
                                       Visibility="{Binding HasSource, Converter={x:Static core:Converters.NotVis}}"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSource, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource GoodBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource TextBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Hint}" Visibility="{Binding SourceText, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Chọn file ISO…" Margin="0,0,8,0" Command="{Binding PickIsoCommand}"/>
                                <Button Content="Thư mục bộ cài…" Command="{Binding PickFolderCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2. USB -->
                <Border c:SectionIndex.Title="USB" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <TextBlock Text="USB" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="Chỉ hiện ổ USB / thẻ nhớ — ổ cứng trong máy và ổ đang chạy Windows không bao giờ có trong danh sách."/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Làm mới" Command="{Binding RefreshCommand}" Margin="8,0,0,0" VerticalAlignment="Stretch"/>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Disk}" DisplayMemberPath="Display"/>
                                    <TextBlock Text="Chưa thấy USB nào — cắm USB (8 GB trở lên) rồi bấm “Làm mới”." Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="12,0,32,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               Visibility="{Binding Disks.Count, Converter={x:Static core:Converters.ZeroVis}}"/>
                                </Grid>
                            </DockPanel>
                            <TextBlock Text="{Binding DisksText}" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Visibility="{Binding DisksText, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 3. Kiểu khởi động & tên -->
                <Border c:SectionIndex.Title="Kiểu khởi động" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Kiểu khởi động &amp; tên USB" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                       Text="GPT cho máy UEFI (hầu hết máy từ 2013). MBR khi cần cài cho máy đời cũ chỉ có BIOS."/>
                            <WrapPanel>
                                <Border Style="{StaticResource Card}" Padding="3" CornerRadius="8" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SchemeSeg}" IsChecked="{Binding Gpt}" Content="GPT — UEFI"/>
                                        <RadioButton Style="{StaticResource SchemeSeg}" IsChecked="{Binding Mbr}" Content="MBR — UEFI + BIOS cũ"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tên USB" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Style="{StaticResource InputBox}" Width="160" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" CharacterCasing="Upper"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 4. Tạo USB -->
                <Border c:SectionIndex.Title="Tạo USB" Style="{StaticResource Card}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="4" Style="{StaticResource StepNum}"/></Border>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding WriteCommand}" VerticalAlignment="Center" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE88E;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="Tạo USB" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tạo USB" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Toàn bộ dữ liệu trên USB sẽ bị xoá. Mất khoảng 10–20 phút tuỳ tốc độ USB." FontSize="12" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Tiến độ -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Dừng" Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Tiến độ" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <ProgressBar Height="6" Margin="0,6,0,0" Value="{Binding Progress}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Result}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="14,0,10,12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
