<UserControl x:Class="ITHelpdeskTool.Views.UsbPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:UsbViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SchemeSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="usbScheme"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,4,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Tạo USB boot" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                       Text="Tạo USB cài Windows từ file ISO gốc của Microsoft. USB định dạng FAT32, khởi động được trên máy UEFI; install.wim lớn hơn 4 GB được tự chia nhỏ."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <!-- 1. Bộ cài -->
                <DockPanel>
                    <Border Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNum}"/></Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Chọn file ISO…" Margin="0,0,8,0" Command="{Binding PickIsoCommand}"/>
                        <Button Content="Thư mục bộ cài…" Command="{Binding PickFolderCommand}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Bộ cài Windows" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="Chưa chọn — tải ISO ở trang “Tải ISO”." Style="{StaticResource Hint}" Visibility="{Binding HasSource, Converter={x:Static core:Converters.NotVis}}"/>
                        <TextBlock Text="{Binding SourceName}" Foreground="{StaticResource TextBrush}" FontSize="12.5" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 2. USB -->
                <DockPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Step}"><TextBlock Text="2" Style="{StaticResource StepNum}"/></Border>
                    <Button DockPanel.Dock="Right" Content="Làm mới" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="USB" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Disk}" DisplayMemberPath="Display"/>
                        <TextBlock Text="{Binding DisksText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Chỉ hiện ổ USB / thẻ nhớ — ổ cứng trong máy và ổ đang chạy Windows không bao giờ có trong danh sách."/>
                    </StackPanel>
                </DockPanel>

                <!-- 3. Tuỳ chọn -->
                <DockPanel Margin="0,18,0,0">
                    <Border Style="{StaticResource Step}"><TextBlock Text="3" Style="{StaticResource StepNum}"/></Border>
                    <StackPanel>
                        <TextBlock Text="Kiểu khởi động" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource Card}" Padding="3" CornerRadius="8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SchemeSeg}" IsChecked="{Binding Gpt}" Content="GPT — UEFI (máy từ 2013)"/>
                                <RadioButton Style="{StaticResource SchemeSeg}" IsChecked="{Binding Mbr}" Content="MBR — UEFI + BIOS cũ"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Tên USB" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Style="{StaticResource InputBox}" Width="160" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="11" CharacterCasing="Upper"/>
                        </DockPanel>
                    </StackPanel>
                </DockPanel>

                <DockPanel Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding WriteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE88E;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Tạo USB" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Foreground="{StaticResource WarnBrush}"
                               Text="Toàn bộ dữ liệu trên USB sẽ bị xoá."/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Tiến độ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Dừng" Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Tiến độ" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                    <ProgressBar Height="6" Margin="0,6,0,0" Value="{Binding Progress}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Result}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="14,0,10,12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
