<UserControl x:Class="ITHelpdeskTool.Views.QueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:InstallQueue}">
    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="16,14,14,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnSmall}" Content="Dừng" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}" ToolTip="Dừng mục đang cài và bỏ các mục còn chờ"/>
                    <Button Style="{StaticResource BtnSmall}" Content="Xoá danh sách" Command="{Binding ClearCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource NotBoolVis}}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Hàng đợi cài đặt" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,12,12">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <DockPanel>
                                    <TextBlock x:Name="Ico" DockPanel.Dock="Left" Width="22" Margin="0,1,6,0" VerticalAlignment="Top"
                                               Style="{StaticResource Icon}" FontSize="13" Text="&#xE823;" Foreground="{DynamicResource FaintBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="St" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="Pb" IsIndeterminate="True" Height="3" Margin="0,5,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Running">
                                    <Setter TargetName="Ico" Property="Text" Value="&#xE895;"/>
                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Pb" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Done">
                                    <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                    <Setter TargetName="Ico" Property="Text" Value="&#xE783;"/>
                                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                    <Setter TargetName="St" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                    <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
