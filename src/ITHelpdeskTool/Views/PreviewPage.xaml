<UserControl x:Class="ITHelpdeskTool.Views.PreviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PreviewViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1100">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
        <Style x:Key="KLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="120"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Đầu trang ghim cố định (không cuộn) -->
            <StackPanel Margin="28,4,22,4">
                <TextBlock Text="Xem trước file" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                           Text="Sửa lỗi không xem trước được file trong File Explorer, và kiểm tra nhanh một file: loại thật, chữ ký số, nguồn tải, mã băm."/>

                <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
            </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Explorer -->
                    <Border c:SectionIndex.Title="File Explorer" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Text="Xem trước trong File Explorer" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Thumbnails}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Ảnh thu nhỏ thay cho biểu tượng" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Xem trước ảnh, video, PDF ngay trên biểu tượng file."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding NetworkThumbnails}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Ảnh thu nhỏ trên thư mục mạng" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Thư mục chia sẻ / NAS. Tắt nếu mạng chậm."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding PreviewHandlers}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="Hiện nội dung trong khung Preview" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Mở khung bằng Alt + P trong File Explorer."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" VerticalAlignment="Center" Command="{Binding UnblockFolderCommand}"/>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="File tải từ Internet không xem trước được" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Windows chặn xem trước file có đánh dấu “tải từ Internet” (tệp đính kèm, file Zalo / trình duyệt). Bỏ chặn cho cả thư mục."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource BtnSmall}" Content="Làm mới bộ đệm ảnh thu nhỏ" Margin="0,0,6,6" Command="{Binding RebuildThumbsCommand}"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Khởi động lại Explorer" Margin="0,0,6,6" Command="{Binding RestartExplorerCommand}"/>
                            </WrapPanel>

                            <DockPanel Margin="0,14,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Đọc lại" Command="{Binding RefreshCommand}"/>
                                <TextBlock Text="{Binding SupportSummary}" Style="{StaticResource Caption}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Supports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,5">
                                            <TextBlock x:Name="Ico" DockPanel.Dock="Left" Width="20" Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center"/>
                                            <TextBlock DockPanel.Dock="Left" Width="150" Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Info" Text="{Binding Suggest}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
                                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                <Setter TargetName="Info" Property="Text" Value="{Binding Handler}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="Muốn xem trước nhiều loại hơn (PDF, SVG, Markdown, mã nguồn) hoặc bấm phím cách để xem nhanh như macOS:"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Style="{StaticResource BtnSmall}" Content="Cài PowerToys (Peek)" Margin="0,0,6,6" Command="{Binding InstallToolCommand}" CommandParameter="Microsoft.PowerToys"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Cài QuickLook" Margin="0,0,6,6" Command="{Binding InstallToolCommand}" CommandParameter="QL-Win.QuickLook"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Kiểm tra file -->
                    <Border c:SectionIndex.Title="Kiểm tra file" Grid.Column="2" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Chọn file…" Command="{Binding PickFileCommand}" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Kiểm tra file" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Xem file nhận qua email / Zalo có an toàn không trước khi mở."/>
                                </StackPanel>
                            </DockPanel>

                            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Report.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                <Border Background="#1AF87171" CornerRadius="8" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding Report.ExtMismatch, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="⚠ Đuôi file không khớp với nội dung thật — cẩn thận, có thể là mã độc giả dạng tài liệu." Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" FontSize="12.5"/>
                                </Border>
                                <StackPanel Margin="0,8,0,0">
                                    <DockPanel Margin="0,2"><TextBlock Text="Loại thật" Style="{StaticResource KLabel}"/><TextBlock Text="{Binding Report.RealType}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></DockPanel>
                                    <DockPanel Margin="0,2"><TextBlock Text="Dung lượng" Style="{StaticResource KLabel}"/><TextBlock Foreground="{DynamicResource TextBrush}"><Run Text="{Binding Report.Size, Mode=OneWay, StringFormat={}{0:N0} byte}"/></TextBlock></DockPanel>
                                    <DockPanel Margin="0,2"><TextBlock Text="Sửa lần cuối" Style="{StaticResource KLabel}"/><TextBlock Text="{Binding Report.Modified, StringFormat=dd/MM/yyyy HH:mm}" Foreground="{DynamicResource TextBrush}"/></DockPanel>
                                    <DockPanel Margin="0,2"><TextBlock Text="Nguồn" Style="{StaticResource KLabel}"/><TextBlock Text="{Binding Report.ZoneText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/></DockPanel>
                                    <DockPanel Margin="0,2" Visibility="{Binding Report.HostUrl, Converter={x:Static core:Converters.NonEmptyVis}}">
                                        <TextBlock Text="Tải từ" Style="{StaticResource KLabel}"/>
                                        <TextBox Style="{StaticResource SelectableValue}" Text="{Binding Report.HostUrl, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,2" Visibility="{Binding Report.Signature, Converter={x:Static core:Converters.NonEmptyVis}}">
                                        <TextBlock Text="Chữ ký số" Style="{StaticResource KLabel}"/>
                                        <TextBlock Text="{Binding Report.Signature}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Report.Signed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,2">
                                        <TextBlock Text="SHA-256" Style="{StaticResource KLabel}"/>
                                        <TextBox Style="{StaticResource SelectableValue}" Text="{Binding Report.Sha256, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Style="{StaticResource BtnSmall}" Content="Mở file" Margin="0,0,6,6" Command="{Binding OpenFileCommand}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Mở thư mục" Margin="0,0,6,6" Command="{Binding ShowInFolderCommand}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Chép SHA-256" Margin="0,0,6,6" Command="{Binding CopyHashCommand}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Tra VirusTotal" Margin="0,0,6,6" Command="{Binding VirusTotalCommand}"
                                            ToolTip="Mở trang VirusTotal theo mã băm — không tải file lên"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Bỏ chặn file" Margin="0,0,6,6" Command="{Binding UnblockFileCommand}"
                                            Visibility="{Binding Report.FromInternet, Converter={StaticResource BoolVis}}"/>
                                </WrapPanel>

                                <!-- Xem trước -->
                                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Margin="0,8,0,0" Padding="8"
                                        Visibility="{Binding Image, Converter={x:Static core:Converters.NotNullVis}}">
                                    <Image Source="{Binding Image}" MaxHeight="420" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBox Text="{Binding Report.Text, Mode=OneWay}" IsReadOnly="True" Margin="0,8,0,0" MaxHeight="420" Padding="10"
                                         Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Visibility="{Binding Report.Text, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/>
                                <Run Text="{Binding Text, Mode=OneWay}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
