<UserControl x:Class="ITHelpdeskTool.Views.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TweaksViewModel}"
             d:DesignWidth="1000" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <core:NullToVisibility x:Key="NullVis"/>

        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
            <StackPanel>

                <!-- ===== Đầu trang ===== -->
                <DockPanel Margin="0,0,0,14">
                    <TextBox DockPanel.Dock="Right" Width="240" VerticalAlignment="Center" Style="{StaticResource SearchBox}" MinHeight="32"
                             Tag="Tìm tweak…" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"/>
                    <StackPanel>
                        <TextBlock Text="Tweaks Windows" Style="{StaticResource H1}"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13"/>
                    </StackPanel>
                </DockPanel>

                <!-- Thanh hành động -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Khởi động lại Explorer" Margin="0,0,8,0" Command="{Binding RestartExplorerCommand}"
                                    ToolTip="Áp dụng ngay thay đổi giao diện mà không cần đăng xuất"/>
                            <Button Style="{StaticResource BtnDanger}" Content="Trả tất cả về mặc định" Command="{Binding ResetAllCommand}"/>
                        </StackPanel>
                        <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Command="{Binding ApplyRecommendedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="Bật các mục khuyên dùng" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Nhắc khởi động lại Explorer / máy -->
                <Border CornerRadius="10" Background="#1A5B8CFF" Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding NeedsExplorer, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Khởi động lại Explorer" Command="{Binding RestartExplorerCommand}"/>
                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Một số thay đổi giao diện cần khởi động lại Explorer (taskbar sẽ tắt rồi hiện lại trong 1–2 giây)."/>
                    </DockPanel>
                </Border>
                <Border CornerRadius="10" Background="#1AFBBF24" BorderBrush="#55FBBF24" BorderThickness="1" Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding NeedsRestart, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Khởi động lại máy" Command="{Binding RestartCommand}"/>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0"/>
                        <TextBlock Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Có tweak chỉ có hiệu lực sau khi khởi động lại máy."/>
                    </DockPanel>
                </Border>

                <!-- ===== Các nhóm ===== -->
                <ItemsControl ItemsSource="{Binding Groups}" IsEnabled="{Binding IsIdle}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border Style="{StaticResource CardIcon}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" Background="#1A5B8CFF" VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="11.5">
                                                <Run Text="{Binding OnCount, Mode=OneWay}"/><Run Text=" đang bật"/>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource Toggle}" Margin="0,0,0,14"
                                                          Visibility="{Binding IsVisible, Converter={StaticResource BoolVis}}"
                                                          IsEnabled="{Binding IsAvailable}" IsChecked="{Binding IsOn}"
                                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                            <Border Style="{StaticResource Badge}" Background="#1A34D399"
                                                                    Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="Khuyên dùng" Style="{StaticResource BadgeText}" Foreground="{StaticResource GoodBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}" Visibility="{Binding EffectText, Converter={StaticResource NullVis}}">
                                                                <TextBlock Text="{Binding EffectText}" Style="{StaticResource BadgeText}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Hint}" Foreground="{StaticResource WarnBrush}"
                                                                   Visibility="{Binding Warning, Converter={StaticResource NullVis}}"/>
                                                        <TextBlock Text="{Binding UnavailableText}" Style="{StaticResource Hint}" Foreground="{StaticResource FaintBrush}"
                                                                   Visibility="{Binding UnavailableText, Converter={StaticResource NullVis}}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ===== Nhật ký ===== -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ActionLog.Count, Converter={x:Static core:Converters.CountVis}}">
                    <StackPanel>
                        <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding ActionLog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Hint}" Width="64" FontFamily="{StaticResource MonoFont}"/>
                                        <TextBlock Width="18" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False">
                                                            <Setter Property="Text" Value="&#xE711;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
