<UserControl x:Class="ITHelpdeskTool.Views.WinPePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WinPeViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1000">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="OutSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="peOut"/>
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,4,22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Text="WinPE" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                           Text="Tạo môi trường cứu hộ Windows PE bằng Windows ADK chính thức của Microsoft — khởi động từ USB để sao lưu dữ liệu, sửa boot, chạy DISM, mở khoá BitLocker khi Windows không vào được."/>

                <!-- ADK -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource LinkButton}" Content="Trang Microsoft" Margin="0,0,12,0" Command="{Binding OpenAdkPageCommand}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="Cài Windows ADK" Command="{Binding InstallAdkCommand}"
                                    Visibility="{Binding HasAdk, Converter={x:Static core:Converters.NotVis}}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="16" Foreground="{StaticResource GoodBrush}" Margin="0,0,12,0"
                                   VerticalAlignment="Center" Visibility="{Binding HasAdk, Converter={StaticResource BoolVis}}"/>
                        <StackPanel>
                            <TextBlock Text="Windows ADK" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AdkText}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tuỳ chọn -->
                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <TextBlock Text="Tuỳ chọn WinPE" Style="{StaticResource H2}"/>

                        <TextBlock Text="Thành phần" Style="{StaticResource Label}"/>
                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Item.Name}" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding Item.Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Driver thêm vào (không bắt buộc)" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnSmall}" Content="Bỏ" Margin="0,0,6,0" Command="{Binding ClearDirCommand}" CommandParameter="drivers"
                                        Visibility="{Binding DriversDir, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" Command="{Binding PickDriversCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DriversDir, TargetNullValue='—'}" Style="{StaticResource PathText}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Driver ổ cứng (Intel RST / VMD, RAID, NVMe) khi WinPE không thấy ổ, hoặc driver card mạng."/>

                        <TextBlock Text="Công cụ portable chép vào X:\Tools (không bắt buộc)" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource BtnSmall}" Content="Bỏ" Margin="0,0,6,0" Command="{Binding ClearDirCommand}" CommandParameter="tools"
                                        Visibility="{Binding ToolsDir, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                <Button Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" Command="{Binding PickToolsCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ToolsDir}" Style="{StaticResource PathText}"/>
                        </DockPanel>

                        <TextBlock Text="Lệnh chạy khi khởi động (không bắt buộc, mỗi dòng một lệnh)" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding StartCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60"
                                 FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Top" TextWrapping="Wrap"/>

                        <TextBlock Text="Thư mục làm việc" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding WorkDir, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"/>

                        <TextBlock Text="Xuất ra" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource Card}" Padding="3" CornerRadius="8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource OutSeg}" IsChecked="{Binding ToIso}" Content="File ISO"/>
                                <RadioButton Style="{StaticResource OutSeg}" IsChecked="{Binding ToUsb}" Content="USB"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding ToIso, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đổi…" Command="{Binding PickIsoCommand}"/>
                            <TextBlock Text="{Binding IsoPath}" Style="{StaticResource PathText}"/>
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding ToUsb, Converter={StaticResource BoolVis}}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Làm mới" Margin="8,0,0,0" Command="{Binding RefreshUsbCommand}"/>
                            <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Disk}" DisplayMemberPath="Display"/>
                        </DockPanel>

                        <DockPanel Margin="0,18,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding BuildCommand}" IsEnabled="{Binding HasAdk}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13"/>
                                    <TextBlock Text="Tạo WinPE" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Mất khoảng 5–15 phút tuỳ số thành phần."/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Tiến độ -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Dừng" Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Tiến độ" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <ProgressBar Height="6" Margin="0,6,0,0" Value="{Binding Progress}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Result}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="14,0,10,12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
