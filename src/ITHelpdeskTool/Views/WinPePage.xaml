<UserControl x:Class="ITHelpdeskTool.Views.WinPePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WinPeViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1000">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="OutSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="peOut"/>
        </Style>
        <Style x:Key="PathText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StepNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,4,22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="460"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Đầu trang ghim cố định -->
        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Text="WinPE" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                       Text="Tạo môi trường cứu hộ Windows PE bằng Windows ADK chính thức của Microsoft — khởi động từ USB để sao lưu dữ liệu, sửa boot, chạy DISM, mở khoá BitLocker khi Windows không vào được."/>
            <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- 1. Windows ADK -->
                <Border c:SectionIndex.Title="Windows ADK" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}"><TextBlock Text="1" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Windows ADK" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource GoodBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Visibility="{Binding HasAdk, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AdkText}" Style="{StaticResource Hint}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="Cài Windows ADK" Command="{Binding InstallAdkCommand}" Margin="0,0,14,0"
                                        Visibility="{Binding HasAdk, Converter={x:Static core:Converters.NotVis}}"/>
                                <Button Style="{StaticResource LinkButton}" Content="Trang Microsoft" Command="{Binding OpenAdkPageCommand}" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2. Thành phần -->
                <Border c:SectionIndex.Title="Thành phần" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}" VerticalAlignment="Top"><TextBlock Text="2" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Thành phần" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="Thêm vào WinPE gốc (cmd, diskpart, bcdboot có sẵn). Càng nhiều thành phần, file càng lớn và tạo càng lâu." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,16,10">
                                            <CheckBox x:Name="Cb" DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                            <StackPanel Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Component_Click">
                                                <TextBlock Text="{Binding Item.Name}" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Item.Description}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 3. Bổ sung -->
                <Border c:SectionIndex.Title="Bổ sung" Style="{StaticResource Card}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}" VerticalAlignment="Top"><TextBlock Text="3" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Bổ sung (không bắt buộc)" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>

                            <DockPanel Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource BtnSmall}" Content="Bỏ" Margin="0,0,6,0" Command="{Binding ClearDirCommand}" CommandParameter="drivers"
                                            Visibility="{Binding DriversDir, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" Command="{Binding PickDriversCommand}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Driver" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding DriversDir}" Style="{StaticResource PathText}" Visibility="{Binding DriversDir, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding DriversDir, Converter={x:Static core:Converters.EmptyVis}}"
                                               Text="Driver ổ cứng (Intel RST / VMD, RAID, NVMe) khi WinPE không thấy ổ, hoặc driver card mạng."/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,12,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Style="{StaticResource BtnSmall}" Content="Bỏ" Margin="0,0,6,0" Command="{Binding ClearDirCommand}" CommandParameter="tools"
                                            Visibility="{Binding ToolsDir, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" Command="{Binding PickToolsCommand}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Công cụ portable" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding ToolsDir}" Style="{StaticResource PathText}" Visibility="{Binding ToolsDir, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding ToolsDir, Converter={x:Static core:Converters.EmptyVis}}"
                                               Text="Chép cả thư mục vào X:\Tools trong WinPE (vd 7-Zip, Notepad++, phần mềm cứu dữ liệu bản portable)."/>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Lệnh chạy khi khởi động" Foreground="{StaticResource TextBrush}" Margin="0,12,0,0"/>
                            <TextBlock Text="Mỗi dòng một lệnh, chạy sau khi WinPE khởi động xong (vd wpeutil InitializeNetwork)." Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding StartCommands, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="60"
                                     FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Top" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 4. Xuất ra -->
                <Border c:SectionIndex.Title="Xuất ra" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Style="{StaticResource Step}" VerticalAlignment="Top"><TextBlock Text="4" Style="{StaticResource StepNum}"/></Border>
                        <StackPanel>
                            <TextBlock Text="Xuất ra" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource Card}" Padding="3" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource OutSeg}" IsChecked="{Binding ToIso}" Content="File ISO"/>
                                        <RadioButton Style="{StaticResource OutSeg}" IsChecked="{Binding ToUsb}" Content="USB"/>
                                    </StackPanel>
                                </Border>
                                <DockPanel VerticalAlignment="Center" Visibility="{Binding ToIso, Converter={StaticResource BoolVis}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đổi…" Margin="8,0,0,0" Command="{Binding PickIsoCommand}"/>
                                    <TextBlock Text="{Binding IsoPath}" Style="{StaticResource PathText}"/>
                                </DockPanel>
                                <DockPanel VerticalAlignment="Center" Visibility="{Binding ToUsb, Converter={StaticResource BoolVis}}">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Làm mới" Margin="8,0,0,0" Command="{Binding RefreshUsbCommand}"/>
                                    <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding Disk}" DisplayMemberPath="Display"/>
                                </DockPanel>
                            </DockPanel>
                            <TextBlock Text="USB sẽ bị xoá toàn bộ dữ liệu." FontSize="12" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding ToUsb, Converter={StaticResource BoolVis}}"/>

                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="Thư mục làm việc" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding WorkDir, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                         ToolTip="Nơi ADK dựng WinPE tạm thời (cần khoảng 1–2 GB trống)"/>
                            </DockPanel>

                            <DockPanel Margin="0,16,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding BuildCommand}" IsEnabled="{Binding HasAdk}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE756;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Tạo WinPE" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Mất khoảng 5–15 phút tuỳ số thành phần. Cần cài Windows ADK ở bước 1."/>
                            </DockPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Tiến độ -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Dừng" Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Tiến độ" Style="{StaticResource H2}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <ProgressBar Height="6" Margin="0,6,0,0" Value="{Binding Progress}" Maximum="100" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Result}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBox x:Name="LogBox" Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Padding="14,0,10,12"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="LogBox_TextChanged"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
