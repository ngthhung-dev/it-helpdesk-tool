<UserControl x:Class="ITHelpdeskTool.Views.OfficePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OfficeViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1400">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style x:Key="KV" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ArchSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="officeArch"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
            <StackPanel>
                <!-- ===== Đầu trang ===== -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Office" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Text="Cài Microsoft Office bản gốc từ máy chủ Microsoft bằng Office Deployment Tool, kiểm tra bản quyền, cập nhật, sửa lỗi, gỡ sạch."/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== Office trên máy ===== -->
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE7C3;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Office trên máy này" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Máy chưa cài Microsoft Office." Style="{StaticResource Hint}" Visibility="{Binding NoOffice, Converter={StaticResource BoolVis}}"/>

                            <StackPanel Visibility="{Binding HasC2R, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding C2r.ProductText}" Style="{StaticResource KV}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                                    <Run Text="Phiên bản"/> <Run Text="{Binding C2r.Version, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                    <Run Text=" · "/><Run Text="{Binding C2r.Platform, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                    <Run Text=" · ngôn ngữ"/> <Run Text="{Binding C2r.Culture, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="Kênh cập nhật:"/> <Run Text="{Binding C2r.Channel, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                </TextBlock>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Cập nhật ngay" Margin="0,0,8,8" Command="{Binding UpdateNowCommand}"/>
                                    <Button Content="Sửa nhanh" Margin="0,0,8,8" Command="{Binding RepairCommand}" CommandParameter="quick"/>
                                    <Button Content="Sửa trực tuyến" Margin="0,0,8,8" Command="{Binding RepairCommand}" CommandParameter="online"/>
                                    <Button Content="Xoá đăng nhập Office" Margin="0,0,8,8" Command="{Binding ResetSignInCommand}"
                                            ToolTip="Sửa lỗi “Unlicensed Product”, đăng nhập lỗi, đổi tài khoản"/>
                                </WrapPanel>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Đổi kênh" Command="{Binding ChangeChannelCommand}" Margin="8,0,0,0"/>
                                    <ComboBox ItemsSource="{Binding SwitchChannels}" SelectedItem="{Binding TargetChannel}" DisplayMemberPath="Name"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding MsiOffice.Count, Converter={x:Static core:Converters.CountVis}}" Margin="0,12,0,0">
                                <TextBlock Text="Office cài kiểu MSI (bản cũ)" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding MsiOffice}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource WarnBrush}"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Hint}" Text="Bản MSI cũ không cài song song được với Office mới — tích “Gỡ bản Office MSI cũ” khi cài."/>
                            </StackPanel>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Gỡ toàn bộ Office" Command="{Binding RemoveAllCommand}" VerticalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="Gỡ sạch mọi bản Office (cả bản lỗi không gỡ được bằng Settings)."/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ===== Bản quyền ===== -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Bản quyền" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding LicenseSummary}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding Licenses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Gỡ key" VerticalAlignment="Center" Margin="10,0,0,0"
                                                        Command="{Binding DataContext.RemoveKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding Last5, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock FontSize="12">
                                                        <Run x:Name="St" Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource WarnBrush}"/>
                                                        <Run Text="  key …" Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Last5, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Licensed}" Value="True">
                                                <Setter TargetName="St" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nhập key bản quyền" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Kích hoạt" Margin="8,0,0,0" Command="{Binding ActivateKeyCommand}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding ProductKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                         Tag="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" CharacterCasing="Upper" MaxLength="29"/>
                            </DockPanel>
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Kích hoạt lại" Command="{Binding ActivateCommand}" Margin="8,0,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="Key bán lẻ / MAK do bạn hoặc tổ chức mua. Bản Microsoft 365: chỉ cần đăng nhập tài khoản trong Word."/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== Cài Office ===== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Border Style="{StaticResource CardIcon}">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cài Office" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Phiên bản" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" DisplayMemberPath="Name"/>
                                <TextBlock Text="{Binding Product.Note}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>

                                <DockPanel Margin="0,0,0,0">
                                    <StackPanel DockPanel.Dock="Left" Margin="0,0,16,0">
                                        <TextBlock Text="Kiến trúc" Style="{StaticResource Label}"/>
                                        <Border Style="{StaticResource Card}" Padding="3" CornerRadius="8" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Style="{StaticResource ArchSeg}" IsChecked="{Binding X64}" Content="64-bit"/>
                                                <RadioButton Style="{StaticResource ArchSeg}" IsChecked="{Binding X86}" Content="32-bit"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Kênh cập nhật" Style="{StaticResource Label}"/>
                                        <ComboBox ItemsSource="{Binding InstallChannels}" SelectedItem="{Binding InstallChannel}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="Ngôn ngữ" Style="{StaticResource Label}"/>
                                <ItemsControl ItemsSource="{Binding Languages}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Item.Name}" Width="190" Margin="0,0,8,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Key sản phẩm (không bắt buộc)" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding InstallKey, UpdateSourceTrigger=PropertyChanged, Delay=300}" FontFamily="{StaticResource MonoFont}"
                                         Tag="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" CharacterCasing="Upper" MaxLength="29"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ứng dụng" Style="{StaticResource Label}"/>
                                <ItemsControl ItemsSource="{Binding Apps}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Item.Name}" Width="190" Margin="0,0,8,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox IsChecked="{Binding Visio}" Content="Kèm Visio" Width="190" Margin="0,0,8,6" IsEnabled="{Binding CanVisio}"/>
                                    <CheckBox IsChecked="{Binding Project}" Content="Kèm Project" Margin="0,0,8,6" IsEnabled="{Binding CanProject}"/>
                                </StackPanel>

                                <TextBlock Text="Tuỳ chọn" Style="{StaticResource Label}"/>
                                <CheckBox IsChecked="{Binding RemoveMsi}" Content="Gỡ bản Office MSI cũ (2010 / 2013 / 2016) trước khi cài" Margin="0,0,0,6"/>
                                <CheckBox IsChecked="{Binding AutoUpdate}" Content="Tự cập nhật Office" Margin="0,0,0,6"/>
                                <CheckBox IsChecked="{Binding ShowUi}" Content="Hiện cửa sổ tiến độ của Microsoft" Margin="0,0,0,6"/>

                                <TextBlock Text="Nguồn cài" Style="{StaticResource Label}"/>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnSmall}" Content="Bỏ" Margin="0,0,6,0" Command="{Binding ClearSourceCommand}"
                                                Visibility="{Binding SourceFolder, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                        <Button Style="{StaticResource BtnSmall}" Content="Dùng bộ cài offline…" Command="{Binding PickSourceCommand}"/>
                                    </StackPanel>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding SourceFolder}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceFolder}" Value="">
                                                        <Setter Property="Text" Value="Tải trực tiếp từ máy chủ Microsoft"/>
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,18,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Lưu file cấu hình…" Margin="0,0,8,0" Command="{Binding SaveXmlCommand}"/>
                                <Button Content="Tải bộ cài offline…" Margin="0,0,8,0" Command="{Binding DownloadOfflineCommand}"
                                        ToolTip="Tải bộ cài về thư mục / USB để cài cho nhiều máy không cần mạng"/>
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding InstallCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Cài đặt Office" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ShowXml}" Content="Xem file cấu hình (XML)" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Style="{StaticResource SelectableValue}" Text="{Binding Xml, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 Margin="0,10,0,0" Padding="12" Background="{StaticResource Surface2Brush}" TextWrapping="Wrap"
                                 Visibility="{Binding ShowXml, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Nhật ký -->
                <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource FaintBrush}"/>
                                <Run Text="{Binding Text, Mode=OneWay}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{StaticResource BadBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
