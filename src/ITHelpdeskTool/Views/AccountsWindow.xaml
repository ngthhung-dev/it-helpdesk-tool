<Window x:Class="ITHelpdeskTool.Views.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý tài khoản" Width="820" Height="640" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid Margin="24,0,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,8,-22,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Đóng"/>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Quản lý tài khoản đăng nhập app" Style="{StaticResource H2}" FontSize="18"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                               Text="Danh sách lưu online (chỉ lưu mã băm mật khẩu). Thay đổi có tác dụng ngay ở lần đăng nhập sau trên mọi máy — không cần build lại app."/>
                </StackPanel>
            </DockPanel>

            <!-- Token GitHub -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,4,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnSmall}" Content="Đặt token…" Click="Token_Click" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnSmall}" Content="Tải lại" Click="Reload_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TokenText" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Để lưu thay đổi cần token GitHub (fine-grained) có quyền Contents: Read and write cho repo it-helpdesk-tool. Token chỉ lưu trên máy này, mã hoá theo tài khoản Windows."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Thêm tài khoản -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Thêm tài khoản" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewUser" Style="{StaticResource InputBox}" Tag="Tên đăng nhập"/>
                        <PasswordBox x:Name="NewPw" Grid.Column="2" ToolTip="Mật khẩu (tối thiểu 6 ký tự)"/>
                        <TextBox x:Name="NewExpires" Grid.Column="4" Style="{StaticResource InputBox}" Tag="Hết hạn dd/MM/yyyy" ToolTip="Để trống = không hết hạn"/>
                        <TextBox x:Name="NewNote" Grid.Column="6" Style="{StaticResource InputBox}" Tag="Ghi chú (vd tên người dùng)"/>
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Thêm" MinWidth="90" Click="Add_Click"/>
                        <CheckBox x:Name="NewAdmin" Content="Quản trị viên (được mở trang quản lý này)" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Danh sách -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource BtnSmall}" Content="Đặt lại mật khẩu" Margin="0,0,6,0" Tag="{Binding}" Click="Reset_Click"/>
                                            <Button Style="{StaticResource BtnSmall}" Content="{Binding ToggleText}" Margin="0,0,6,0" Tag="{Binding}" Click="Toggle_Click"/>
                                            <Button Style="{StaticResource BtnSmall}" Content="Hạn dùng" Margin="0,0,6,0" Tag="{Binding}" Click="Expire_Click"/>
                                            <Button Style="{StaticResource BtnSmall}" Content="Xoá" Foreground="{DynamicResource BadBrush}" Tag="{Binding}" Click="Delete_Click"/>
                                        </WrapPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock>
                                                <Run Text="{Binding A.User, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding AdminText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Margin="0,2,0,0">
                                                <Run Text="{Binding StatusText, Mode=OneWay}" Foreground="{Binding StatusBrush, Mode=OneWay}"/>
                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Row="4" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Thông báo màn hình đăng nhập…" Click="Message_Click"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
