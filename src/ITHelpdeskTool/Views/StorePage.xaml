<UserControl x:Class="ITHelpdeskTool.Views.StorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:v="clr-namespace:ITHelpdeskTool.Views"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StoreViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="TabSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="storeTab"/>
        </Style>
        <Style x:Key="EmptyHidden" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasUpdate}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,9"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28,4,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Đầu trang ===== -->
            <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
                <TextBox DockPanel.Dock="Right" Width="280" VerticalAlignment="Center" Style="{StaticResource SearchBox}" MinHeight="32"
                         Tag="Tìm phần mềm…" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchWingetCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel>
                    <TextBlock Text="App Store" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap">
                        <Run Text="Cài phần mềm sạch từ nguồn chính hãng — chọn bộ có sẵn hoặc tự tích, app cài lần lượt, im lặng, không phải bấm Next."/>
                        <Run Text="{Binding WingetText, Mode=OneWay}" Foreground="{StaticResource FaintBrush}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- Thiếu winget -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{StaticResource WarnBrush}"
                    Visibility="{Binding WingetMissing, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Cài winget" Command="{Binding RepairWingetCommand}" VerticalAlignment="Center"/>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Máy chưa có winget" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Windows 10 bản cũ hoặc máy mới cài chưa cập nhật App Installer. Bấm “Cài winget” để tự đăng ký / tải bản mới nhất từ Microsoft."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,12" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabBrowse}" Content="Khám phá"/>
                    <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabUpdates}" Content="Cập nhật phần mềm"/>
                    <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabExtras}" Content="Bộ cài &amp; thành phần Windows"/>
                </StackPanel>
            </Border>

            <!-- ===================== KHÁM PHÁ ===================== -->
            <DockPanel Grid.Row="3" Visibility="{Binding TabBrowse, Converter={StaticResource BoolVis}}">
                <!-- Bộ có sẵn -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="Bộ có sẵn:" Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding SkipInstalled}" Content="Bỏ qua phần mềm đã cài" VerticalAlignment="Top" Margin="12,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Chip}" CommandParameter="{Binding}" ToolTip="{Binding Description}"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <TextBlock><Run Text="{Binding Name, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/><Run Text=" · "/><Run Text="{Binding Ids.Length, Mode=OneWay}"/></TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <!-- Danh mục + tóm tắt: ghim cùng đầu trang -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Categories}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="storeCat" Content="{Binding Label}" IsChecked="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Làm mới trạng thái" Command="{Binding RefreshInstalledCommand}"/>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                </DockPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <!-- Tìm trên kho winget -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,10" Visibility="{Binding SearchText, Converter={x:Static core:Converters.NonEmptyVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Tìm" Command="{Binding SearchWingetCommand}"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SearchText}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding SearchResults.Count, Converter={x:Static core:Converters.CountVis}}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Đóng" Command="{Binding ClearSearchCommand}"/>
                                    <TextBlock Text="Kết quả trên kho winget" Style="{StaticResource H2}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding SearchResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource BtnSmall}" Content="Cài"
                                                                Command="{Binding DataContext.InstallSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <Button.Visibility>
                                                                <MultiBinding Converter="{x:Static core:Converters.AllFalseVis}">
                                                                    <Binding Path="IsInstalled"/>
                                                                    <Binding Path="IsQueued"/>
                                                                </MultiBinding>
                                                            </Button.Visibility>
                                                        </Button>
                                                        <TextBlock Text="Đã cài" Foreground="{StaticResource GoodBrush}" FontSize="12" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="Trong hàng đợi" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsQueued, Converter={StaticResource BoolVis}}"/>
                                                    </Grid>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Row.Name}" Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Style="{StaticResource Hint}"><Run Text="{Binding Row.Id, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Row.Version, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Lưới phần mềm -->
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVis}}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Width="292" Height="118" Margin="0,0,10,10" CornerRadius="12" Padding="14,12"
                                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <TextBlock Text="Trong hàng đợi…" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center"
                                                               Visibility="{Binding IsQueued, Converter={StaticResource BoolVis}}"/>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsQueued, Converter={StaticResource NotBoolVis}}">
                                                        <Button Style="{StaticResource BtnSmall}" Content="Cài"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource NotBoolVis}}"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource BtnSmall}" Content="Cập nhật" Margin="6,0,0,0"
                                                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolVis}}"
                                                                Command="{Binding DataContext.UpgradeAppRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource BtnSmall}" Content="Gỡ" Margin="6,0,0,0" Foreground="{StaticResource BadBrush}"
                                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource StateText}" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="8,0,0,0"
                                                      Visibility="{Binding IsInstalled, Converter={StaticResource NotBoolVis}}" ToolTip="Chọn để cài nhiều phần mềm cùng lúc"/>
                                            <Border Style="{StaticResource Avatar}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding App.Initial}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding App.Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding App.Description}" Style="{StaticResource Hint}" Margin="0,2,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===================== CẬP NHẬT ===================== -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Visibility="{Binding TabUpdates, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnSmall}" Content="Kiểm tra lại" Margin="6,0,0,0" Command="{Binding LoadUpgradesCommand}"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="Cập nhật mục đã chọn" Margin="8,0,0,0" Command="{Binding UpgradeSelectedCommand}"
                                    Visibility="{Binding Upgrades.Count, Converter={x:Static core:Converters.CountVis}}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding UpgradeSummary}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Chỉ gồm phần mềm winget nhận ra. Phần mềm đang mở có thể cần đóng lại để cập nhật."/>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,14,12">
                        <ItemsControl ItemsSource="{Binding Upgrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="{Binding CanUpgrade}"/>
                                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                                <Button Style="{StaticResource BtnSmall}" Content="Cập nhật" IsEnabled="{Binding CanUpgrade}"
                                                        Visibility="{Binding IsQueued, Converter={StaticResource NotBoolVis}}"
                                                        Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <TextBlock Text="Trong hàng đợi" Foreground="{StaticResource AccentBrush}" FontSize="12"
                                                           Visibility="{Binding IsQueued, Converter={StaticResource BoolVis}}"/>
                                            </Grid>
                                            <TextBlock DockPanel.Dock="Right" Width="230" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="12.5">
                                                <Run Text="{Binding Row.Version, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                <Run Text="  →  " Foreground="{StaticResource FaintBrush}"/>
                                                <Run Text="{Binding Row.Available, Mode=OneWay}" Foreground="{StaticResource WarnBrush}"/>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Row.Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Row.Id}" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===================== BỘ CÀI & THÀNH PHẦN WINDOWS ===================== -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" Visibility="{Binding TabExtras, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Thành phần Windows" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding NetFx3}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Bật .NET Framework 3.5 (gồm 2.0 và 3.0)" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding NetFx3State}" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding UpgradeAll}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Cập nhật mọi phần mềm khác lên bản mới nhất" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="winget upgrade --all — chạy sau cùng" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" AllowDrop="True" Drop="Offline_Drop" DragOver="Offline_DragOver">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnSmall}" Content="Bỏ danh sách" Margin="0,0,6,0" Command="{Binding ClearOfflineCommand}"
                                            Visibility="{Binding Offline.Count, Converter={x:Static core:Converters.CountVis}}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" Command="{Binding PickFolderCommand}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Bộ cài có sẵn trong thư mục / USB" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Bấm “Chọn thư mục…” hoặc kéo thả thư mục vào đây (vd thư mục bộ cài trên USB). App nhận diện bộ cài MSI, Inno Setup, NSIS, InstallShield, WiX… để cài im lặng; bộ cài không rõ kiểu sẽ mở giao diện bình thường."/>
                            <TextBlock Text="{Binding OfflineFolder}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                       Visibility="{Binding OfflineFolder, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                            <ItemsControl ItemsSource="{Binding Offline}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock x:Name="Ty" DockPanel.Dock="Right" Text="{Binding Type.Label}" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource GoodBrush}"/>
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type.CanSilent}" Value="False">
                                                <Setter TargetName="Ty" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox IsChecked="{Binding OfflineSilent}" Margin="0,10,0,0" Content="Cài im lặng khi nhận ra kiểu bộ cài"
                                      Visibility="{Binding Offline.Count, Converter={x:Static core:Converters.CountVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Thanh dưới: danh sách + cài mục đã chọn (cả phần mềm, bộ cài, thành phần Windows) -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,10"
                    Visibility="{Binding TabUpdates, Converter={StaticResource NotBoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Bỏ chọn" Margin="0,0,8,0" Command="{Binding ClearSelectionCommand}"
                                Visibility="{Binding SelectedCount, Converter={x:Static core:Converters.CountVis}}"/>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding InstallSelectedCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="{Binding InstallText}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mở danh sách…" Margin="0,0,8,0" Command="{Binding OpenListCommand}" ToolTip="Mở danh sách đã lưu (.json)"/>
                        <Button Content="Lưu danh sách…" Margin="0,0,12,0" Command="{Binding SaveListCommand}" ToolTip="Lưu lựa chọn để dùng cho máy khác"/>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Cài lần lượt, im lặng: .NET 3.5 → runtime → phần mềm → bộ cài trong thư mục."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hàng đợi -->
            <v:QueuePanel Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" Width="320" Margin="12,0,0,0" DataContext="{Binding Queue}"
                          Visibility="{Binding Items.Count, Converter={x:Static core:Converters.CountVis}}"/>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
