<UserControl x:Class="ITHelpdeskTool.Views.BrowserBackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BrowserBackupViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="28,4,22,4">
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Sao lưu trình duyệt" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                                   Text="Sao lưu và khôi phục nguyên hồ sơ trình duyệt (bookmark, mật khẩu đã lưu, cookie, tiện ích) khi cài lại trình duyệt. Chỉ chép file — không giải mã gì."/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Khôi phục…" Command="{Binding RestoreCommand}" VerticalAlignment="Center"
                                        ToolTip="Chọn thư mục sao lưu để đưa dữ liệu trình duyệt về máy"/>
                                <StackPanel>
                                    <TextBlock Text="Trình duyệt trên máy" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding B.Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Top" Margin="0,1,14,0"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Xuất mật khẩu…" VerticalAlignment="Top" Margin="8,0,0,0" CommandParameter="{Binding}"
                                                        ToolTip="Dùng khi cài lại Windows: mở trang Export của trình duyệt (trình duyệt sẽ hỏi xác thực Windows)"
                                                        Command="{Binding DataContext.ExportPasswordsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding B.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding B.Detail}" Style="{StaticResource Hint}"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Status, Converter={x:Static core:Converters.NonEmptyVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusOk}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding BackupCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Sao lưu trình duyệt đã chọn…" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="Khôi phục trên cùng máy (cài lại trình duyệt): bookmark và mật khẩu về đầy đủ. Cài lại Windows / máy khác: bookmark về được, mật khẩu đã lưu có thể không mở được — khi đó dùng “Xuất mật khẩu” hoặc bật đồng bộ của trình duyệt."/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding ActionLog.Count, Converter={x:Static core:Converters.CountVis}}">
                        <StackPanel>
                            <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/>
                                        <Run Text="{Binding Text, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
