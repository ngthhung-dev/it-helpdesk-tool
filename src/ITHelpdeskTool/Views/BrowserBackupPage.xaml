<UserControl x:Class="ITHelpdeskTool.Views.BrowserBackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BrowserBackupViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="28,4,22,4">
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Sao lưu trình duyệt" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                                   Text="Sao lưu bookmark, mật khẩu đã lưu và cookie của mọi hồ sơ trình duyệt. Sao lưu / cookie chỉ chép file (không giải mã) — khôi phục trên cùng máy thì mở lại được."/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Trình duyệt trên máy" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding B.Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding B.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding B.Detail}" Style="{StaticResource Hint}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Margin="0,0,8,8" Command="{Binding BackupBookmarksPasswordsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Sao lưu bookmark + mật khẩu…" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Sao lưu cookie…" Margin="0,0,8,8" Command="{Binding BackupCookiesCommand}"/>
                                <Button Content="Xuất bookmark + mật khẩu…" Margin="0,0,8,8" Command="{Binding ExportBookmarksPasswordsCommand}"/>
                                <Button Content="Khôi phục…" Margin="0,0,8,8" Command="{Binding RestoreCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Sao lưu / cookie: chép file, khôi phục trên cùng máy giữ được mật khẩu và đăng nhập. Xuất: bookmark ra HTML, mật khẩu do trình duyệt tự Export (có xác thực Windows). Cài lại Windows thì dùng Xuất. File xuất chứa mật khẩu — dùng xong hãy xóa."/>

                            <!-- Luồng xuất mật khẩu từng hồ sơ -->
                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                                    Visibility="{Binding ExportActive, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ExportCurrent}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Trên cửa sổ trình duyệt vừa mở: bấm nút “Export passwords / Xuất mật khẩu” → xác thực Windows → lưu file. Xong quay lại đây bấm nút dưới." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ExportNextLabel}" Style="{StaticResource Hint}" Margin="0,4,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnPrimary}" Content="Mở hồ sơ tiếp theo" Margin="0,0,8,0" Command="{Binding NextExportCommand}"/>
                                        <Button Content="Dừng" Command="{Binding CancelExportCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding ActionLog.Count, Converter={x:Static core:Converters.CountVis}}">
                        <StackPanel>
                            <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/>
                                        <Run Text="{Binding Text, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
