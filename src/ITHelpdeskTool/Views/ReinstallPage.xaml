<UserControl x:Class="ITHelpdeskTool.Views.ReinstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ReinstallViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1400">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Dòng chọn: ô tick + tên + dung lượng + ghi chú -->
        <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type vm:Choice}">
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Hint}" VerticalAlignment="Top" Margin="12,2,0,0"/>
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="T" Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Visibility="{Binding Detail, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                        </StackPanel>
                    </CheckBox>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Danger}" Value="True">
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="28,4,22,4">
                <TextBlock Text="Cài lại sạch" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                           Text="Xoá ổ Windows đang chạy rồi cài Windows mới từ ISO, không cần USB. Kiểm tra máy, sao lưu dữ liệu quan trọng, cài xong tự tạo tài khoản, cài phần mềm và chép lại dữ liệu."/>
                <c:SectionIndex Target="{Binding ElementName=PageScroller}" Margin="0,0,0,2"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
                <StackPanel IsEnabled="{Binding IsIdle}">

                    <!-- Đã chuẩn bị, chờ khởi động lại -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                            Visibility="{Binding Armed, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Mở thư mục đệm" Margin="0,0,8,0" Command="{Binding OpenStagingCommand}"/>
                                <Button Content="Huỷ cài lại" Command="{Binding CancelArmCommand}"/>
                            </StackPanel>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource WarnBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Máy đã được đặt để cài lại ở lần khởi động kế tiếp" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Khởi động lại là bắt đầu xoá ổ và cài. Không muốn cài nữa thì bấm “Huỷ cài lại”."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 1. Bộ cài -->
                    <Border c:SectionIndex.Title="1. Bộ cài" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Chọn file ISO…" Command="{Binding PickImageCommand}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE958;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="1. Bộ cài Windows" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding HasImage, Converter={x:Static core:Converters.NotVis}}"
                                       Text="Chọn ISO gốc của Microsoft (tải ở trang “Tải ISO”), hoặc install.wim / install.esd trong bộ cài đã giải nén."/>
                            <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding ImagePath}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="Bản cài" Style="{StaticResource Label}" Width="110"/>
                                    <ComboBox ItemsSource="{Binding Editions}" SelectedItem="{Binding Edition}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="110,4,0,0"
                                           Text="Chọn đúng loại đang dùng (Home / Pro…) thì Windows mới tự kích hoạt bằng bản quyền số của máy. App không kèm công cụ kích hoạt."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Ổ đệm -->
                    <Border c:SectionIndex.Title="2. Ổ đệm" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="2. Nơi để file cài và bản sao lưu" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding StagingOptions}" SelectedItem="{Binding Staging}" DisplayMemberPath="Display"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                       Text="Cần trống khoảng: dung lượng ISO + dữ liệu sao lưu + 5 GB (tối thiểu 12 GB). Phân vùng nên nằm cùng ổ cứng với Windows (máy UEFI bật Fast Boot có thể không thấy ổ cứng thứ hai)."/>
                        </StackPanel>
                    </Border>

                    <!-- 3. Sao lưu -->
                    <Border c:SectionIndex.Title="3. Sao lưu" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đo lại" Command="{Binding ScanBackupCommand}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="3. Sao lưu trước khi xoá" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding BackupTotal}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding BackupItems}" ItemTemplate="{StaticResource ChoiceTemplate}"/>
                            <CheckBox IsChecked="{Binding RestoreAfter}" Margin="0,8,0,0" Content="Cài xong tự chép lại vào tài khoản mới (Desktop, Documents, Wi-Fi, bookmark…)"/>
                            <CheckBox IsChecked="{Binding IgnoreBackupErrors}" Margin="0,4,0,0" Content="Vẫn cài tiếp nếu có file không sao lưu được (file đang mở, đường dẫn lỗi)"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. Windows mới -->
                    <Border c:SectionIndex.Title="4. Windows mới" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="4. Cài đặt cho Windows mới" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Tài khoản" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource InputBox}" Tag="Admin" Grid.Column="1" Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MicrosoftAccount, Converter={x:Static core:Converters.Not}}"/>
                                <TextBlock Grid.Column="3" Text="Mật khẩu" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource InputBox}" Tag="Để trống = không mật khẩu" Grid.Column="4" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MicrosoftAccount, Converter={x:Static core:Converters.Not}}"
                                         ToolTip="Để trống = không đặt mật khẩu. Mật khẩu ghi dạng mã hoá base64 trong unattend.xml, bị xoá sau khi cài xong."/>
                                <TextBlock Grid.Row="2" Text="Tên máy" Style="{StaticResource Label}"/>
                                <TextBox Style="{StaticResource InputBox}" Tag="Để trống = tên ngẫu nhiên" Grid.Row="2" Grid.Column="1" Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <CheckBox IsChecked="{Binding MicrosoftAccount}" Margin="0,10,0,0"
                                      Content="Đăng nhập tài khoản Microsoft lúc cài (cần mạng; không tạo tài khoản ở trên)"/>
                            <CheckBox IsChecked="{Binding PreventDeviceEncryption}" Margin="0,4,0,0"
                                      Content="Không tự bật mã hoá thiết bị (Windows 11 24H2 tự mã hoá ổ khi đăng nhập tài khoản Microsoft)"/>
                            <CheckBox IsChecked="{Binding ExportDrivers}" Margin="0,4,0,0"
                                      Content="Chép driver của máy này sang Windows mới (khuyên dùng; bắt buộc với máy RAID / Intel RST)"/>

                            <TextBlock Text="Phần mềm cài sẵn" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <ItemsControl ItemsSource="{Binding Software}" ItemTemplate="{StaticResource ChoiceTemplate}"/>
                            <TextBlock Text="Tinh chỉnh" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Mục chữ đỏ làm giảm an toàn của máy — mặc định không chọn, chỉ bật khi thật sự cần."/>
                            <ItemsControl ItemsSource="{Binding Tweaks}" ItemTemplate="{StaticResource ChoiceTemplate}"/>
                        </StackPanel>
                    </Border>

                    <!-- 5. Kiểm tra -->
                    <Border c:SectionIndex.Title="5. Kiểm tra" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Kiểm tra máy" Command="{Binding CheckCommand}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="5. Kiểm tra máy &amp; tương thích" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding CheckText}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- BitLocker ổ Windows -->
                            <Border Style="{StaticResource Row}" Visibility="{Binding TargetEncrypted, Converter={StaticResource BoolVis}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Tắt mã hoá" Command="{Binding DecryptCommand}" VerticalAlignment="Center" Margin="12,0,0,0"
                                            Visibility="{Binding Decrypting, Converter={x:Static core:Converters.NotVis}}"/>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource WarnBrush}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding EncryptionText}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Checks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CheckRow}">
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <TextBlock x:Name="Ico" DockPanel.Dock="Left" Width="22" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14"
                                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Visibility="{Binding Detail, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                                    <CheckBox IsChecked="{Binding Confirmed}" Margin="0,6,0,0" Content="Tôi đã hiểu và đồng ý cài lại máy này"
                                                              Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolVis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                                <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
                                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warn">
                                                <Setter TargetName="Ico" Property="Text" Value="&#xE7BA;"/>
                                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Block">
                                                <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 6. Bắt đầu -->
                    <Border c:SectionIndex.Title="6. Bắt đầu" Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{DynamicResource BadBrush}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Xoá &amp; cài lại Windows…" Command="{Binding StartCommand}"
                                        IsEnabled="{Binding CanStart}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource BadBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="6. Xoá ổ và cài lại" Style="{StaticResource H2}"/>
                                    <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource BadBrush}" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Thứ tự: sao lưu → chép file cài, tạo môi trường cài → đặt khởi động một lần → khởi động lại → xoá ổ, cài Windows mới → tạo tài khoản, cài phần mềm, chép lại dữ liệu. Lỗi trước bước xoá ổ thì máy tự quay về Windows hiện tại."/>
                            <TextBlock Text="{Binding Result}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BadBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultOk}" Value="True"><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/></DataTrigger>
                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="8,6" Margin="0,10,0,0" Height="220" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="LogChanged"
                                     Visibility="{Binding LogText, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9" MaxWidth="900"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
