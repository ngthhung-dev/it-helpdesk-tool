<UserControl x:Class="ITHelpdeskTool.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignWidth="1000" d:DesignHeight="760">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <core:NullToVisibility x:Key="NullVis"/>
        <core:NullToVisibility x:Key="NotNullVis" Invert="True"/>
        <core:EmptyToDash x:Key="Dash"/>

        <!-- Một dòng "nhãn : giá trị" -->
        <Style x:Key="KeyText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ValText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="KvRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
        <StackPanel>

            <!-- ===== Đầu trang ===== -->
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" ToolTip="Đọc lại thông tin phần cứng">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="Làm mới" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Command="{Binding CopyInfoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="{Binding CopyStatus}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13">
                        <Run Text="{Binding Hardware.OsName, Mode=OneWay, FallbackValue='Windows'}"/>
                        <Run Text="{Binding Hardware.OsVersion, Mode=OneWay}"/>
                        <Run Text=" · Máy chạy liên tục"/>
                        <Run Text="{Binding UptimeText, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- ===== 4 thẻ số liệu ===== -->
            <UniformGrid Columns="4" Margin="-6,0,-6,0">

                <!-- CPU -->
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,16,18,10">
                    <StackPanel>
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Width="58" Height="58">
                                <c:RingGauge Value="{Binding CpuPercent}" Stroke="{StaticResource AccentBrush}" Thickness="6"/>
                                <TextBlock Text="&#xE950;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
                                <TextBlock Style="{StaticResource BigNumber}" Margin="0,4,0,0">
                                    <Run Text="{Binding CpuPercent, StringFormat={}{0:0}, Mode=OneWay}"/><Run Text="%" FontSize="16" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Hardware.Threads, StringFormat={}{0} luồng, FallbackValue='…'}"/>
                            </StackPanel>
                        </DockPanel>
                        <c:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource AccentBrush}" Height="34" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}" Margin="6" Padding="18,16,18,10">
                    <StackPanel>
                        <DockPanel>
                            <Grid DockPanel.Dock="Right" Width="58" Height="58">
                                <c:RingGauge Value="{Binding RamPercent}" Stroke="{StaticResource VioletBrush}" Thickness="6"/>
                                <TextBlock Text="&#xEEA0;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="RAM" Style="{StaticResource Caption}"/>
                                <TextBlock Style="{StaticResource BigNumber}" Margin="0,4,0,0">
                                    <Run Text="{Binding RamPercent, StringFormat={}{0:0}, Mode=OneWay}"/><Run Text="%" FontSize="16" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding RamText}"/>
                            </StackPanel>
                        </DockPanel>
                        <c:Sparkline Values="{Binding RamHistory}" Stroke="{StaticResource VioletBrush}" Height="34" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pin -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="58" Height="58" VerticalAlignment="Top">
                            <c:RingGauge Value="{Binding BatteryPercent}" Stroke="{StaticResource GoodBrush}" Thickness="6" UseThresholds="False"/>
                            <TextBlock Text="{Binding BatteryGlyph}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="PIN" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource BigNumber}" Margin="0,4,0,0"
                                       Visibility="{Binding HasBattery, Converter={StaticResource BoolVis}}">
                                <Run Text="{Binding BatteryPercent, Mode=OneWay}"/><Run Text="%" FontSize="16" Foreground="{StaticResource MutedBrush}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource BigNumber}" Text="AC" Margin="0,4,0,0"
                                       Visibility="{Binding HasBattery, Converter={StaticResource NotBoolVis}}"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding BatteryText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Ổ hệ thống -->
                <Border Style="{StaticResource Card}" Margin="6">
                    <DockPanel>
                        <Grid DockPanel.Dock="Right" Width="58" Height="58" VerticalAlignment="Top">
                            <c:RingGauge Value="{Binding SystemDrivePercent}" Stroke="{StaticResource WarnBrush}" Thickness="6"/>
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="Ổ HỆ THỐNG" Style="{StaticResource Caption}"/>
                            <TextBlock Style="{StaticResource BigNumber}" Margin="0,4,0,0">
                                <Run Text="{Binding SystemDrivePercent, StringFormat={}{0:0}, Mode=OneWay}"/><Run Text="%" FontSize="16" Foreground="{StaticResource MutedBrush}"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding SystemDriveText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Phần cứng + ổ đĩa ===== -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Phần cứng -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Cấu hình máy" Style="{StaticResource H2}" Margin="0,0,0,14"/>

                        <TextBlock Text="Đang đọc thông tin phần cứng…" Style="{StaticResource Muted}"
                                   Visibility="{Binding Hardware, Converter={StaticResource NotNullVis}}"/>

                        <StackPanel Visibility="{Binding Hardware, Converter={StaticResource NullVis}}">
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="Tên máy" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}">
                                    <Run Text="{Binding Hardware.ComputerName, Mode=OneWay}"/>
                                    <Run Text="{Binding Hardware.Domain, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="Hãng / Model" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}">
                                    <Run Text="{Binding Hardware.Manufacturer, Mode=OneWay}"/>
                                    <Run Text="{Binding Hardware.Model, Mode=OneWay}"/>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="Serial" Style="{StaticResource KeyText}"/>
                                <TextBox Text="{Binding Hardware.SerialNumber, Mode=OneWay, Converter={StaticResource Dash}}" IsReadOnly="True"
                                         Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource TextBrush}"
                                         FontFamily="{StaticResource MonoFont}" ToolTip="Bôi đen để chép"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="Hệ điều hành" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}">
                                    <Run Text="{Binding Hardware.OsName, Mode=OneWay}"/>
                                    <Run Text="{Binding Hardware.OsVersion, Mode=OneWay}"/>
                                    <Run Text="{Binding Hardware.OsBuild, Mode=OneWay, StringFormat='· build {0}'}" Foreground="{StaticResource MutedBrush}"/>
                                    <Run Text="{Binding Hardware.Architecture, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="CPU" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}">
                                    <Run Text="{Binding Hardware.CpuName, Mode=OneWay}"/>
                                    <LineBreak/>
                                    <Run Foreground="{StaticResource MutedBrush}" Text="{Binding Hardware.Cores, Mode=OneWay, StringFormat={}{0} nhân}"/>
                                    <Run Foreground="{StaticResource MutedBrush}" Text="{Binding Hardware.Threads, Mode=OneWay, StringFormat='/ {0} luồng'}"/>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="RAM" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}">
                                    <Run Text="{Binding Hardware.RamTotalGb, Mode=OneWay, StringFormat={}{0:0} GB}"/>
                                    <Run Text="{Binding Hardware.RamDetail, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}">
                                <TextBlock Text="Card đồ hoạ" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}" Text="{Binding Hardware.Gpu, Converter={StaticResource Dash}}"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource KvRow}" Margin="0">
                                <TextBlock Text="Mainboard" Style="{StaticResource KeyText}"/>
                                <TextBlock Style="{StaticResource ValText}">
                                    <Run Text="{Binding Hardware.Mainboard, Mode=OneWay}"/>
                                    <Run Text="{Binding Hardware.Bios, Mode=OneWay, StringFormat='· BIOS {0}'}" Foreground="{StaticResource MutedBrush}"/>
                                </TextBlock>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ổ đĩa -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ổ đĩa" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}">
                                                <Run Text="{Binding FreeGb, Mode=OneWay, StringFormat={}{0:0}}"/><Run Text=" GB trống / "/><Run Text="{Binding TotalGb, Mode=OneWay, StringFormat={}{0:0} GB}"/>
                                            </TextBlock>
                                            <TextBlock Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,7,0,4">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsedPercent, Converter={x:Static core:Thresholds.Over90}}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Style="{StaticResource Caption}" FontWeight="Normal">
                                            <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Format, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Công cụ nhanh ===== -->
            <TextBlock Text="Mở nhanh công cụ Windows" Style="{StaticResource H2}" Margin="0,24,0,12"/>
            <ItemsControl ItemsSource="{Binding QuickTools}" Margin="-5,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Margin="5"
                                Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Target}" ToolTip="{Binding ToolTipText}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
