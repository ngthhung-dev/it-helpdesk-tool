<UserControl x:Class="ITHelpdeskTool.Views.AppBackupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:AppBackupViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Đầu trang ghim cố định (không cuộn) -->
            <StackPanel Margin="28,4,22,4">
                <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Đọc lại" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Sao lưu phần mềm" Style="{StaticResource H1}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                                   Text="Sao lưu dữ liệu MISA SME, ECUS, FAST, Bravo (cơ sở dữ liệu SQL Server) và HTKK ra USB / ổ khác trước khi cài lại Windows. Chỉ sao lưu — khôi phục bằng chức năng của từng phần mềm."/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,6,22,28">
            <StackPanel>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Dữ liệu tìm thấy" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" IsEnabled="{Binding I.CanBackup}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource BtnSmall}" Content="Đăng nhập SQL…" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                            Visibility="{Binding NeedsLogin, Converter={StaticResource BoolVis}}"
                                                            Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Style="{StaticResource BtnSmall}" Content="Bật dịch vụ" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                            Visibility="{Binding Stopped, Converter={StaticResource BoolVis}}"
                                                            Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Style="{StaticResource BtnSmall}" Content="Mở thư mục" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding I.Name}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <Border Style="{StaticResource Badge}">
                                                            <TextBlock Text="{Binding I.App}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding I.Detail}" FontSize="12" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding I.Path}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding I.Path, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding Status, Converter={x:Static core:Converters.NonEmptyVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusOk}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding BackupCommand}" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Sao lưu mục đã chọn…" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="Cơ sở dữ liệu được sao lưu khi phần mềm vẫn mở (bản sao riêng, không ảnh hưởng sao lưu của phần mềm) và được kiểm tra đọc lại. Kèm file DANH-SACH-SAO-LUU.txt ghi phiên bản SQL Server — khôi phục vào bản cùng hoặc mới hơn."/>
                            </DockPanel>
                            <ProgressBar Height="6" Margin="0,10,0,0" Maximum="100" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Nhật ký thao tác -->
                    <Border Style="{StaticResource Card}" Visibility="{Binding ActionLog.Count, Converter={x:Static core:Converters.CountVis}}">
                        <StackPanel>
                            <TextBlock Text="Nhật ký thao tác" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding ActionLog}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,3">
                                        <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource FaintBrush}"/>
                                        <Run Text="{Binding Text, Mode=OneWay}">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{DynamicResource BadBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
