<UserControl x:Class="ITHelpdeskTool.Views.FontsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ITHelpdeskTool.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FontsViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
        <core:LegacySampleConverter x:Key="LegacySample"/>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="TabSeg" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
            <Setter Property="GroupName" Value="fontTab"/>
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <Style x:Key="SampleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="EmptyHidden" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28,4,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Đầu trang ===== -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnSmall}" Content="Sao lưu font cài thêm…" Margin="6,0,0,0" Command="{Binding BackupCommand}"
                            ToolTip="Chép mọi font không phải của Windows ra một thư mục — để cài lại sau khi cài lại máy"/>
                    <Button Style="{StaticResource BtnSmall}" Content="Sửa lỗi font" Margin="6,0,0,0" Command="{Binding ResetCacheCommand}"
                            ToolTip="Xoá bộ đệm font khi chữ hiển thị sai / ra ô vuông"/>
                    <Button Style="{StaticResource BtnSmall}" Content="Thư mục Fonts" Margin="6,0,0,0" Command="{Binding OpenFontsFolderCommand}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Cài font" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap"
                               Text="Cài nhiều font một lần (cả file .zip), xem trước chữ tiếng Việt, kiểm tra font có đủ dấu không."/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Padding="4" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabNew}" Content="Cài font mới"/>
                        <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabInstalled}" Content="Font đã cài"/>
                        <RadioButton Style="{StaticResource TabSeg}" IsChecked="{Binding TabGoogle}" Content="Font miễn phí (Google)"/>
                    </StackPanel>
                </Border>
                <TextBox Style="{StaticResource InputBox}" Margin="12,0,0,0" VerticalAlignment="Center" MinHeight="34"
                         Text="{Binding Sample, UpdateSourceTrigger=PropertyChanged, Delay=200}" ToolTip="Câu xem trước — gõ nội dung bất kỳ"/>
            </DockPanel>

            <!-- ===================== CÀI MỚI ===================== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding TabNew, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Chọn file font…" Margin="0,0,8,0" Command="{Binding PickFilesCommand}"/>
                            <Button Content="Chọn thư mục…" Command="{Binding PickFolderCommand}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding NewSummary}" Foreground="{StaticResource TextBrush}" Visibility="{Binding NewFonts.Count, Converter={x:Static core:Converters.CountVis}}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Hỗ trợ .ttf, .otf, .ttc, .fon và file .zip chứa font."/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,14" Visibility="{Binding NewFonts.Count, Converter={x:Static core:Converters.CountVis}}">
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Chọn:" Style="{StaticResource Hint}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource LinkButton}" Content="Tất cả" Margin="0,0,12,0" Command="{Binding SelectNewCommand}" CommandParameter="all"/>
                            <Button Style="{StaticResource LinkButton}" Content="Chưa cài" Margin="0,0,12,0" Command="{Binding SelectNewCommand}" CommandParameter="new"/>
                            <Button Style="{StaticResource LinkButton}" Content="Có dấu tiếng Việt" Margin="0,0,12,0" Command="{Binding SelectNewCommand}" CommandParameter="vn"/>
                            <Button Style="{StaticResource LinkButton}" Content="Bỏ chọn" Command="{Binding SelectNewCommand}" CommandParameter="none"/>
                        </WrapPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Xoá danh sách" Margin="0,0,8,0" Command="{Binding ClearNewCommand}"/>
                                <Button Style="{StaticResource BtnPrimary}" Command="{Binding InstallNewCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                        <TextBlock Text="Cài font đã chọn" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AllUsers}" Content="Cài cho mọi tài khoản" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NewFonts.Count, Converter={x:Static core:Converters.ZeroVis}}">
                            <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentSoftBrush}">
                                <TextBlock Text="&#xE8D2;" Style="{StaticResource Icon}" FontSize="26" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chọn file font hoặc thư mục chứa font để bắt đầu" Foreground="{StaticResource TextBrush}" Margin="0,14,0,4" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="App đọc cả thư mục con và file .zip, báo font nào đã cài, font nào thiếu dấu tiếng Việt."/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding NewFonts}" Background="Transparent" BorderThickness="0" Padding="10,0,10,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 Visibility="{Binding NewFonts.Count, Converter={x:Static core:Converters.CountVis}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Info.Display}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                <Border x:Name="Vn" Style="{StaticResource Badge}" Background="#1A34D399">
                                                    <TextBlock x:Name="VnT" Text="{Binding Badge}" Style="{StaticResource BadgeText}" Foreground="{StaticResource GoodBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource Badge}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="Đã cài" Style="{StaticResource BadgeText}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Info.FileName}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock FontFamily="{Binding Family}" Style="{StaticResource SampleText}" Visibility="{Binding Info.Legacy, Converter={StaticResource NotBoolVis}}">
                                                <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LegacySample}">
                                    <Binding Path="DataContext.Sample" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding Path="Info.Family"/>
                                </MultiBinding>
                            </TextBlock.Text>
                                            </TextBlock>
                                            <c:LegacyFontText Text="{Binding DataContext.Sample, RelativeSource={RelativeSource AncestorType=UserControl}}" Wrap="False"
                                                              FontFile="{Binding Info.Path}" FamilyName="{Binding Info.Family}" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"
                                                              ClipToBounds="True" Visibility="{Binding Info.Legacy, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{Binding Result}" Style="{StaticResource EmptyHidden}" Foreground="{StaticResource GoodBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                            <Setter TargetName="Vn" Property="Background" Value="#1AFBBF24"/>
                                            <Setter TargetName="VnT" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                            <Setter TargetName="Vn" Property="Background" Value="#1AF87171"/>
                                            <Setter TargetName="VnT" Property="Foreground" Value="{StaticResource BadBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ===================== ĐÃ CÀI ===================== -->
            <Grid x:Name="InstalledGrid" Grid.Row="2" Visibility="{Binding TabInstalled, Converter={StaticResource BoolVis}}" SizeChanged="InstalledGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="18,14,18,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBox Width="180" Style="{StaticResource SearchBox}" MinHeight="30" Tag="Tìm font…"
                                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
                                <Button Style="{StaticResource BtnSmall}" Margin="8,0,0,0" Command="{Binding LoadInstalledCommand}" ToolTip="Đọc lại danh sách font">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding InstalledSummary}" Style="{StaticResource Hint}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding ScanText}" Style="{StaticResource EmptyHidden}" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel DockPanel.Dock="Top" Margin="18,0,18,4">
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontScope" IsChecked="{Binding ScopeAll}" Content="{Binding CountAll}"/>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontScope" IsChecked="{Binding ScopeWindows}" Content="{Binding CountWindows}"/>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontScope" IsChecked="{Binding ScopeAdded}" Content="{Binding CountAdded}"/>
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="18,0,18,8" IsEnabled="{Binding Scanned}">
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontLang" IsChecked="{Binding LangAll}" Content="Mọi ngôn ngữ"/>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontLang" IsChecked="{Binding LangVn}" Content="{Binding CountVn}"
                                         ToolTip="Font Unicode có đủ chữ có dấu tiếng Việt"/>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontLang" IsChecked="{Binding LangLegacy}" Content="{Binding CountLegacy}"
                                         ToolTip="Font việt hoá kiểu cũ (.VnTime, VNI-Times…) — gõ bằng bảng mã TCVN3/VNI trong UniKey"/>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="fontLang" IsChecked="{Binding LangNone}" Content="{Binding CountNone}"/>
                        </WrapPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="18,8,18,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Command="{Binding UninstallCheckedCommand}" IsEnabled="{Binding HasChecked}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13"/>
                                    <TextBlock Text="{Binding CheckedText}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Chọn:" Style="{StaticResource Hint}" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource LinkButton}" Content="Mọi font cài thêm đang hiện" Margin="0,0,12,0" Command="{Binding SelectInstalledCommand}" CommandParameter="visible"/>
                                <Button Style="{StaticResource LinkButton}" Content="Bỏ chọn" Command="{Binding SelectInstalledCommand}" CommandParameter="none" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding ShowOwnFont}" Content="Hiện tên bằng chính font" VerticalAlignment="Center"
                                          ToolTip="Tắt đi nếu máy có rất nhiều font và cuộn bị chậm"/>
                            </WrapPanel>
                        </DockPanel>

                        <ListBox x:Name="InstalledList" ItemsSource="{Binding InstalledView}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0" Padding="8,0,8,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="10,10">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,6" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Height="44">
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanRemove}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  ToolTip="Chọn để gỡ (font của Windows không gỡ được)"/>
                                        <Border x:Name="Vn" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#1A34D399" Margin="8,0,0,0">
                                            <TextBlock x:Name="VnT" Text="{Binding Badge}" Style="{StaticResource BadgeText}" Foreground="{StaticResource GoodBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="NameT" Text="{Binding Font.Name}" FontSize="16" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ShowOwnFont, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                            <Setter TargetName="NameT" Property="FontFamily" Value="{Binding Family}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Badge}" Value="">
                                            <Setter TargetName="Vn" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                            <Setter TargetName="Vn" Property="Background" Value="#1AFBBF24"/>
                                            <Setter TargetName="VnT" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border x:Name="DetailPanel" Grid.Column="1" Width="400" Margin="12,0,0,0" Style="{StaticResource Card}"
                        Visibility="{Binding HasSelected, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnDanger}" Content="Gỡ font" Command="{Binding UninstallFontCommand}"
                                    IsEnabled="{Binding Selected.Font.IsSystem, Converter={x:Static core:Converters.Not}}"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Font đi kèm Windows không gỡ được."
                                       Visibility="{Binding Selected.Font.IsSystem, Converter={StaticResource BoolVis}}"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,0" Padding="0,0,8,0">
                            <StackPanel>
                        <TextBlock Text="{Binding Selected.Font.Name}" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border x:Name="SelVn" Style="{StaticResource Badge}" Background="#1A34D399" Visibility="{Binding Selected.Vietnamese, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Đủ dấu tiếng Việt" Style="{StaticResource BadgeText}" Foreground="{StaticResource GoodBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="#1AFBBF24" Visibility="{Binding Selected.Legacy, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="Font mã cũ VNI/TCVN3" Style="{StaticResource BadgeText}" Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource WarnBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Selected.Legacy, Converter={StaticResource BoolVis}}"
                                   Text="Chữ mẫu đã được đổi sang bảng mã của font để xem đúng dấu. Gõ trong Word: chọn bảng mã TCVN3 (font .Vn…) hoặc VNI Windows (font VNI-…) trong UniKey."/>
                        <StackPanel Visibility="{Binding Selected.Legacy, Converter={StaticResource NotBoolVis}}">
                        <TextBlock FontFamily="{Binding Selected.Family}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LegacySample}">
                                    <Binding Path="Sample"/>
                                    <Binding Path="Selected.FamilyName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock FontFamily="{Binding Selected.Family}" FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LegacySample}">
                                    <Binding Path="Sample"/>
                                    <Binding Path="Selected.FamilyName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock FontFamily="{Binding Selected.Family}" FontSize="32" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LegacySample}">
                                    <Binding Path="Sample"/>
                                    <Binding Path="Selected.FamilyName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock FontFamily="{Binding Selected.Family}" FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LegacySample}">
                                    <Binding Source="AaBbCc ĂăÂâĐđÊêÔôƠơƯư ẤấỀềỔổỮữỴỵ"/>
                                    <Binding Path="Selected.FamilyName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Selected.Legacy, Converter={StaticResource BoolVis}}">
                            <c:LegacyFontText Text="{Binding Sample}" FontFile="{Binding Selected.Font.File}" FamilyName="{Binding Selected.FamilyName}" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"/>
                            <c:LegacyFontText Text="{Binding Sample}" FontFile="{Binding Selected.Font.File}" FamilyName="{Binding Selected.FamilyName}" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"/>
                            <c:LegacyFontText Text="{Binding Sample}" FontFile="{Binding Selected.Font.File}" FamilyName="{Binding Selected.FamilyName}" FontSize="32" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"/>
                            <c:LegacyFontText Text="AaBbCc ĂăÂâĐđÊêÔôƠơƯư ẤấỀềỔổỮữỴỵ" FontFile="{Binding Selected.Font.File}" FamilyName="{Binding Selected.FamilyName}" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
                        </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===================== GOOGLE ===================== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding TabGoogle, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="18,14,18,8">
                        <TextBlock Style="{StaticResource Hint}" Text="Font miễn phí, dùng được cả cho mục đích thương mại (giấy phép SIL OFL), đều có đủ dấu tiếng Việt. Tải từ kho github.com/google/fonts."/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="18,10,18,14">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding InstallWebCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                                <TextBlock Text="Tải và cài font đã chọn" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <CheckBox IsChecked="{Binding AllUsers}" Content="Cài cho mọi tài khoản" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
                        <ItemsControl ItemsSource="{Binding WebFonts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Font.Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                                    <Border Style="{StaticResource Badge}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="Đã cài" Style="{StaticResource BadgeText}" Foreground="{StaticResource GoodBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Font.Style}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DataContext.Sample, RelativeSource={RelativeSource AncestorType=UserControl}}" FontFamily="{Binding Family}"
                                                           Style="{StaticResource SampleText}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Nhật ký -->
            <ItemsControl Grid.Row="3" ItemsSource="{Binding ActionLog}" Margin="0,10,0,0" MaxHeight="64">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="{StaticResource FaintBrush}"/>
                            <Run Text="{Binding Text, Mode=OneWay}">
                                <Run.Style>
                                    <Style TargetType="Run">
                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False"><Setter Property="Foreground" Value="{StaticResource BadBrush}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Run.Style>
                            </Run>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
