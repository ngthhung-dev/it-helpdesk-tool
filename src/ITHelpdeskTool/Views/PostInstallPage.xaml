<UserControl x:Class="ITHelpdeskTool.Views.PostInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:v="clr-namespace:ITHelpdeskTool.Views"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PostInstallViewModel}"
             d:DesignWidth="1200" d:DesignHeight="900">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,9"/>
        </Style>
        <Style x:Key="PresetCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="232"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="14,12" MinHeight="86">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="28,4,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Đầu trang ===== -->
            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
                <TextBlock Text="App sau cài Win" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap">
                    <Run Text="Máy mới cài Windows: chọn một bộ có sẵn hoặc tự tích, bấm cài — app tự cài lần lượt, im lặng."/>
                    <Run Text="{Binding WingetText, Mode=OneWay}" Foreground="{StaticResource FaintBrush}"/>
                </TextBlock>
                <!-- Bộ có sẵn -->
                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,12,0,-12">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PresetCard}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding Ids.Length, Mode=OneWay}"/><Run Text=" phần mềm"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>

                    <!-- Phần mềm -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding SkipInstalled}" Content="Bỏ qua phần mềm đã cài" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Kiểm tra lại" Command="{Binding RefreshInstalledCommand}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Phần mềm" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                            <ItemsControl ItemsSource="{Binding Apps}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Width="236" Margin="0,0,8,7" IsChecked="{Binding IsChecked}" ToolTip="{Binding App.Description}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding App.Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                                <TextBlock Text=" · đã cài" Foreground="{StaticResource GoodBrush}" FontSize="11.5" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}"/>
                                                                <TextBlock Text=" · đang chờ" Foreground="{StaticResource AccentBrush}" FontSize="11.5" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsQueued, Converter={StaticResource BoolVis}}"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Thành phần Windows -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Thành phần Windows" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding NetFx3}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Bật .NET Framework 3.5 (gồm 2.0 và 3.0)" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding NetFx3State}" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding UpgradeAll}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Cập nhật mọi phần mềm khác lên bản mới nhất" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="winget upgrade --all — chạy sau cùng" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Bộ cài trong thư mục -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" AllowDrop="True" Drop="Offline_Drop" DragOver="Offline_DragOver">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnSmall}" Content="Bỏ danh sách" Margin="0,0,6,0" Command="{Binding ClearOfflineCommand}"
                                            Visibility="{Binding Offline.Count, Converter={x:Static core:Converters.CountVis}}"/>
                                    <Button Style="{StaticResource BtnSmall}" Content="Chọn thư mục…" Command="{Binding PickFolderCommand}"/>
                                </StackPanel>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bộ cài có sẵn trong thư mục / USB" Style="{StaticResource H2}"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                       Text="Bấm “Chọn thư mục…” (vd thư mục bộ cài trên USB). App nhận diện bộ cài MSI, Inno Setup, NSIS, InstallShield, WiX… để cài im lặng; bộ cài không rõ kiểu sẽ mở giao diện bình thường."/>
                            <TextBlock Text="{Binding OfflineFolder}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource FaintBrush}"
                                       Visibility="{Binding OfflineFolder, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                            <ItemsControl ItemsSource="{Binding Offline}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                <TextBlock x:Name="Ty" DockPanel.Dock="Right" Text="{Binding Type.Label}" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource GoodBrush}"/>
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type.CanSilent}" Value="False">
                                                <Setter TargetName="Ty" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox IsChecked="{Binding OfflineSilent}" Margin="0,10,0,0" Content="Cài im lặng khi nhận ra kiểu bộ cài"
                                      Visibility="{Binding Offline.Count, Converter={x:Static core:Converters.CountVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Thanh dưới -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="16,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="13"/>
                            <TextBlock Text="{Binding StartText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mở danh sách…" Margin="0,0,8,0" Command="{Binding OpenListCommand}" ToolTip="Mở danh sách đã lưu (.json)"/>
                        <Button Content="Lưu danh sách…" Margin="0,0,8,0" Command="{Binding SaveListCommand}" ToolTip="Lưu lựa chọn để dùng cho máy khác"/>
                        <Button Content="Bỏ chọn" Command="{Binding ClearAllCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <v:QueuePanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="320" Margin="12,0,0,0" DataContext="{Binding Queue}"
                          Visibility="{Binding Items.Count, Converter={x:Static core:Converters.CountVis}}"/>
        </Grid>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,80" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
