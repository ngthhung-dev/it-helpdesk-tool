<UserControl x:Class="ITHelpdeskTool.Views.WinInstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:ITHelpdeskTool.Core"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:WinInstallViewModel}"
             d:DesignWidth="1200" d:DesignHeight="1000">

    <UserControl.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
        </Style>
        <Style x:Key="CardIcon" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
            <StackPanel>
                <TextBlock Text="Cài Windows" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,14" FontSize="13" TextWrapping="Wrap"
                           Text="Kiểm tra yêu cầu Windows 11, cài lại Windows giữ nguyên dữ liệu, mở trình cài đặt gốc từ ISO của Microsoft, vào môi trường khôi phục."/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Yêu cầu Windows 11 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Kiểm tra lại" Command="{Binding CheckCommand}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Yêu cầu Windows 11" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding CurrentOs}" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{Binding ReadinessText}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                            <ItemsControl ItemsSource="{Binding Readiness}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Row}">
                                            <DockPanel>
                                                <TextBlock x:Name="Ico" DockPanel.Dock="Left" Width="22" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="14"
                                                           Foreground="{StaticResource WarnBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Visibility="{Binding Note, Converter={x:Static core:Converters.NonEmptyVis}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Pass}" Value="True">
                                                <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
                                                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Pass}" Value="False">
                                                <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="Ico" Property="Foreground" Value="{StaticResource BadBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Khôi phục -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Border Style="{StaticResource CardIcon}">
                                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Khôi phục &amp; khởi động" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="Môi trường khôi phục (WinRE):"/> <Run Text="{Binding WinRe, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                            </TextBlock>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Khởi động lại" Command="{Binding RebootRecoveryCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Vào Advanced Startup" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Startup Repair, System Restore, gỡ bản cập nhật lỗi, khởi động từ USB, vào BIOS/UEFI."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="Mở" Command="{Binding OpenRecoveryCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Reset this PC" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Cài đặt lại Windows có sẵn trên máy (giữ hoặc xoá dữ liệu) trong Settings › Recovery."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Bộ cài -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" IsEnabled="{Binding IsIdle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Chọn file ISO…" Margin="0,0,8,0" Command="{Binding PickIsoCommand}"/>
                                <Button Content="Thư mục / USB bộ cài…" Command="{Binding PickFolderCommand}"/>
                            </StackPanel>
                            <Border Style="{StaticResource CardIcon}">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Cài từ bộ cài Windows" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Chọn ISO gốc của Microsoft (tải ở trang “Tải ISO”)." Visibility="{Binding HasMedia, Converter={x:Static core:Converters.NotVis}}"/>

                        <StackPanel Visibility="{Binding HasMedia, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding MediaName}" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="{Binding MediaText}" Style="{StaticResource Hint}"/>
                            <ItemsControl ItemsSource="{Binding Editions}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="{StaticResource Surface2Brush}" Padding="8,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding Display}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Kiểm tra" Command="{Binding CompatCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Kiểm tra tương thích" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Chạy setup.exe ở chế độ chỉ quét: cho biết có cài lại giữ nguyên dữ liệu được không, không thay đổi gì trên máy."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Cài lại giữ dữ liệu" Command="{Binding RepairUpgradeCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Cài lại Windows giữ nguyên ứng dụng &amp; dữ liệu (repair install)" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Thay toàn bộ file hệ thống bằng bản mới từ bộ cài — sửa được lỗi nặng mà SFC / DISM bó tay. Cũng dùng để nâng cấp lên bản Windows mới hơn."/>
                                        <CheckBox IsChecked="{Binding DynamicUpdate}" Content="Tải bản cập nhật mới nhất trong lúc cài (cần mạng)" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Row}" BorderThickness="0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Mở setup.exe" Command="{Binding OpenSetupCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Mở trình cài đặt Windows" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Tự chọn cách cài trên giao diện của Microsoft. Cài sạch lên máy khác: tạo USB ở trang “Tạo USB boot” rồi khởi động từ USB."/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Result}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultOk}" Value="True"><Setter Property="Foreground" Value="{StaticResource GoodBrush}"/></DataTrigger>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" CornerRadius="20" Padding="18,9"
                Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
