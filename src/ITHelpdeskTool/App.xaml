<Application x:Class="ITHelpdeskTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             xmlns:v="clr-namespace:ITHelpdeskTool.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ánh xạ ViewModel -> View cho vùng nội dung -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <v:DashboardPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportViewModel}">
                <v:ReportPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SysConfigViewModel}">
                <v:SysConfigPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PolicyViewModel}">
                <v:PolicyPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <v:AboutPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <v:PlaceholderPage/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
