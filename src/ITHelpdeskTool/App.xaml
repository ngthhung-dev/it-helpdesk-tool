<Application x:Class="ITHelpdeskTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ITHelpdeskTool.ViewModels"
             xmlns:v="clr-namespace:ITHelpdeskTool.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Ánh xạ ViewModel -> View cho vùng nội dung -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <v:DashboardPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportViewModel}">
                <v:ReportPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SysConfigViewModel}">
                <v:SysConfigPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PolicyViewModel}">
                <v:PolicyPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                <v:StartupPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PowerViewModel}">
                <v:PowerPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
                <v:TweaksPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanupViewModel}">
                <v:CleanupPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UninstallViewModel}">
                <v:UninstallPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StoreViewModel}">
                <v:StorePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FontsViewModel}">
                <v:FontsPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PostInstallViewModel}">
                <v:PostInstallPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OfficeViewModel}">
                <v:OfficePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WinInstallViewModel}">
                <v:WinInstallPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WinPeViewModel}">
                <v:WinPePage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsbViewModel}">
                <v:UsbPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IsoViewModel}">
                <v:IsoPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RepairViewModel}">
                <v:RepairPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BitLockerViewModel}">
                <v:BitLockerPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiskViewModel}">
                <v:DiskPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UserFoldersViewModel}">
                <v:UserFoldersPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PrinterViewModel}">
                <v:PrinterPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OutlookViewModel}">
                <v:OutlookPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
                <v:PreviewPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MultiZaloViewModel}">
                <v:MultiZaloPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <v:AboutPage/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <v:PlaceholderPage/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
