<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nền & bề mặt -->
    <Color x:Key="BgColor">#0E1014</Color>
    <Color x:Key="SidebarColor">#121419</Color>
    <Color x:Key="SurfaceColor">#171A21</Color>
    <Color x:Key="Surface2Color">#1E222B</Color>
    <Color x:Key="BorderColor">#262B36</Color>

    <!-- Chữ -->
    <Color x:Key="TextColor">#E8EAF0</Color>
    <Color x:Key="MutedColor">#8A92A6</Color>
    <Color x:Key="FaintColor">#5A6175</Color>

    <!-- Nhấn & trạng thái -->
    <Color x:Key="AccentColor">#5B8CFF</Color>
    <Color x:Key="AccentSoftColor">#1F2A44</Color>
    <Color x:Key="GoodColor">#34D399</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="BadColor">#F87171</Color>
    <Color x:Key="VioletColor">#A78BFA</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Hover2Brush" Color="#33FFFFFF"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
