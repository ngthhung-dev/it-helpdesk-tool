<Window x:Class="DeskMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskMate.ViewModels"
        xmlns:core="clr-namespace:DeskMate.Core"
        Title="DeskMate" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:ShellViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <core:BoolToVisibility x:Key="BoolVis"/>
        <core:BoolToVisibility x:Key="NotBoolVis" Invert="True"/>
    </Window.Resources>

    <!-- Khi phóng to, WindowChrome tràn viền ~7px → đệm lại -->
    <Border x:Name="Root">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ SIDEBAR ============ -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,14,0,18">
                        <Border Width="28" Height="28" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{StaticResource VioletColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="14"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeskMate" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="IT Helpdesk Toolkit" FontSize="10.5" Foreground="{StaticResource FaintBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Chân sidebar -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,2"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}"
                                    Background="#1A34D399">
                                <TextBlock Text="Admin" FontSize="11" Foreground="{StaticResource GoodBrush}"/>
                            </Border>
                            <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,2"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource NotBoolVis}}"
                                    Background="#1AFBBF24" ToolTip="Một số chức năng cần chạy với quyền Administrator">
                                <TextBlock Text="Không có quyền admin" FontSize="11" Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5">
                                <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- Menu -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,6,10">
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="10,6,0,4"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 CommandParameter="{Binding}">
                                                        <DockPanel>
                                                            <Ellipse DockPanel.Dock="Right" Width="5" Height="5" Fill="{StaticResource FaintBrush}"
                                                                     VerticalAlignment="Center" ToolTip="Sắp có"
                                                                     Visibility="{Binding IsReady, Converter={StaticResource NotBoolVis}}"/>
                                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Width="20"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                            <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                        </DockPanel>
                                                    </RadioButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ VÙNG NỘI DUNG ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Thanh tiêu đề (kéo được) -->
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Thu nhỏ"/>
                        <Button Style="{StaticResource CaptionButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" ToolTip="Phóng to"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Đóng"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource Muted}" Margin="28,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>

                <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
