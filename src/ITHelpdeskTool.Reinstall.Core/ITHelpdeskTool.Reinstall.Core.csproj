<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lõi tính năng "Cài lại Windows" dùng chung cho app chính (.NET 10) và bản nhẹ cho Win 7 (.NET Framework 4.8).
    Chỉ dùng API của netstandard2.0 và gọi công cụ có sẵn của Windows (dism, bcdedit, powershell) — không P/Invoke, không WPF.
    Windows 7: thêm wimlib-imagex (đi kèm bộ cài) và DiscUtils — xem Legacy.cs.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ITHelpdeskTool.Reinstall</RootNamespace>
    <AssemblyName>ITHelpdeskTool.Reinstall.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ITHelpdeskTool.Reinstall.Tests" />
  </ItemGroup>

  <!-- Đọc file .iso trong code cho Windows 7 (không có Mount-DiskImage). MIT. -->
  <ItemGroup>
    <PackageReference Include="DiscUtils.Udf" Version="0.16.13" />
    <!-- Đọc registry (SQL Server, phần mềm đã cài) trên netstandard2.0 -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Chủ sở hữu file font (phân biệt font của Windows với font cài thêm) -->
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" LogicalName="ITH.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
